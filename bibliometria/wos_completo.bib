@article{ WOS:001793211600007,
Author = {Castaneda-Rodriguez, Victor Mauricio and Leon-Silva, Jeimi Maribel},
Title = {Empirical Assessment of the Fiscal Laziness Hypothesis in Colombian
   Municipalities: Evidence for the 2011-2017 Period},
Journal = {APUNTES DEL CENES},
Year = {2026},
Volume = {45},
Number = {81},
Pages = {177-200},
Month = {JAN-JUN},
Abstract = {The territorial finances of Colombia are characterized by a high
   dependence on transfers from the national government. Some authors (S \&
   aacute;nchez-Torres et al., 2015) interpret this as a sign of fiscal
   laziness; however, the empirical evidence on this issue remains
   inconclusive. This paper uses panel data with annual observations for
   approximately 1,100 municipalities between 2011 and 2017 to examine
   whether alternative sources of revenue substitute for municipal tax
   collection, or whether low tax performance is instead explained by
   structural factors such as limited economic and institutional capacity.
   The results indicate that subnational tax revenue in Colombia depends
   primarily on its own trajectory (i.e., fiscal inertia), on the economic
   capacity of territorial entities (measured by GDP per capita), and on
   the electoral cycle. Moreover, transfers from the General System of
   Participations and the General System of Royalties are not negatively
   associated with the municipal tax burden; rather, the relationship
   appears to be positive. These findings suggest that intergovernmental
   transfers do not necessarily discourage local tax effort, but may
   instead complement it, highlighting the importance of considering
   institutional capacity and economic context when designing policies to
   strengthen local fiscal autonomy.},
