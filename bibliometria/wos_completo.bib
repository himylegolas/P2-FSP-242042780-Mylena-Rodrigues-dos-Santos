@article{ WOS:001814961700001,
Author = {Xu, J. X. and Kim, G. S.},
Title = {LOCAL INDUSTRIAL LAND LEASING AND SPATIAL AIR ENVIRONMENTAL POLLUTION
   UNDER LAND-USE REFORM: CLIMATE AND GEOGRAPHY CHANNELS IN CHINESE CITIES},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Volume = {24},
Number = {4},
Pages = {6953-6972},
Abstract = {China's industrial-land use reforms unlocked sizable rental revenues for
   local governments through industrial land leasing while externalizing
   the associated air environmental pollution costs beyond municipal
   borders. Using annual city-level panel data that span the decade before
   and after the reforms, we find three core patterns. First, regional
   heterogeneity is stark: the interaction term ``policy reform \& times;
   land leasing{''} increases PM10 and API by roughly 60\% in high-price
   coastal cities, but is statistically insignificant in central regions.
   Second, Geo-climatic factors strongly amplify the effect: east of the Hu
   Huanyong Line, high-pressure systems coupled with high temperature and
   humidity raise the marginal API increment by 4\% per degree of
   longitude, an effect that diminishes with altitude. Third, spatial
   spillovers are persistent: consistently high Moran's I values from the
   W5 matrix indicate that converting one hectare of land can propagate
   PM10 to neighboring counties. Overall, fiscal decentralization without
   cross-jurisdictional coordination merely relocates ecological
   externalities. Unified electronic bidding and supra-local enforcement
   are required to internalize both land leasing and pollution costs,
   thereby breaking the path dependence of ``environmental corruption{''}
   inherited from stimulus-era land finance.},
