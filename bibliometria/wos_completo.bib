@article{ WOS:001620573200001,
Author = {Khan, Zeeshan and Chatti, Walid and Ali, Sher and Zhu, Xufeng},
Title = {Integrating fiscal reforms, green innovation, and governance
   effectiveness for sustainable ESG transitions in developed economies},
Journal = {JOURNAL OF ENVIRONMENTAL MANAGEMENT},
Year = {2025},
Volume = {395},
Month = {DEC},
Abstract = {This study investigates a novel aspect of environmental, social, and
   governance sustainability uncertainty (ESGUI) regarding the
   institutional, innovation, governance, and policy dimensions of G7
   economies for the period 2003 to 2023, offering panel data analysis for
   this context. From an institutional perspective, the results indicate
   that fiscal decentralization has a negative effect on ESGUI by
   increasing local accountability while decreasing uncertainty due to
   increasing fiscal power. Additionally, the renewable energy R\&D budget
   and green innovation help restrain ESGUI through increasing technology
   and investment in clean energy projects. The results indicate that
   government effectiveness has a positive effect (linear) but a sizeable
   negative effect when it is nonlinear. These results suggest the need for
   appropriate innovation policies, in conjunction with the institutional
   role to reduce uncertainty and a more decentralized fiscal framework, to
   increase local governments' role, increase investment in clean energy
   R\&D, and encourage green innovation. The role of government efficiency
   confirms a lower risk of uncertainty in the G7 economies. The study
   contributes to the policy discourse by presenting a clear course for
   governance-innovation and institutional links to limit ESG volatility.},
Publisher = {ACADEMIC PRESS LTD- ELSEVIER SCIENCE LTD},
