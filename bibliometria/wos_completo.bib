@article{ WOS:000229075600007,
Author = {Bryson, PJ and Cornia, GC and Wheeler, GE},
Title = {Fiscal decentralization in the Czech and Slovak Republics: a comparative
   study of moral hazard},
Journal = {ENVIRONMENT AND PLANNING C-GOVERNMENT AND POLICY},
Year = {2004},
Volume = {22},
Number = {1},
Pages = {103-113},
Month = {FEB},
Abstract = {Fiscal decentralization has provided neither the benefits of
   decentralization nor an independent revenue source for subriational
   governments in the Czech and Slovak Republics. In Slovakia political
   conditions early in the transition led to the relative neglect of
   revenue transfers from the center. This produced financial stress but
   also encouraged greater fiscal independence for local governments. It
   also forced them to seek maximal property tax revenues. The Czech
   Republic made more substantial transfers to local governments, but the
   development of fiscal autonomy was stifled as transfers reduced the need
   for own-source local revenues. The Czech real estate tax has remained
   nominal, as it was under central planning, and its administration is
   fraught with moral hazard problems. Thus, the property tax never became
   a vehicle for generating independent funds, but the prospects for the
   tax are much brighter in the Slovak Republic. This paper offers several
   views on why the property tax has been more successful in the Slovak
   Republic.},
