@article{ WOS:000444028100006,
Author = {Lewis, Blane D.},
Title = {Indonesian Decentralization: Accountability Deferred},
Journal = {INTERNATIONAL JOURNAL OF PUBLIC ADMINISTRATION},
Year = {2010},
Volume = {33},
Number = {12-13, SI},
Pages = {348-357},
Abstract = {For nearly a decade, Indonesia has been engaged in one of the world's
   largest programs of public sector decentralization. The evidence
   suggests that Indonesian decentralization has not yet, however, led to
   good quality local public services. Implementation of immediate remedies
   typically proposed by government officials and others are all likely to
   be deficient in one regard or another. A long-term, incremental approach
   that focuses on experimenting with out-put-based central-local incentive
   grants, enhancing local government capability in expenditure and revenue
   management, and, most importantly, building capacity in civil society
   groups to educate citizens and motivate demand seems the most feasible
   strategy for moving forward under the current circumstances.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
