@article{ WOS:001525840800005,
Author = {Zhang, Xiaolei and Zhu, Yun and Hou, Aocheng},
Title = {Fiscal decentralization and urban-rural inequality of income acquisition
   opportunities: Micro evidence from China},
Journal = {FINANCE RESEARCH LETTERS},
Year = {2025},
Volume = {85},
Number = {A},
Month = {NOV},
Abstract = {This study examines how fiscal decentralization affects urban-rural
   inequality in income acquisition opportunities in China. Using microdata
   from the China Family Panel Studies (CFPS), we construct a
   counterfactual model to isolate income disparities driven solely by
   urban-rural structural differences. The results show that fiscal
   decentralization significantly exacerbates such inequality, primarily by
   inducing urban-biased public resource allocation as a result of
   promotion-driven competition among local governments. The effect is more
   pronounced in cities with intense intergovernmental competition and
   lower agricultural dependence, while it is attenuated in cities with
   higher levels of urban-rural integration and greater reliance on
   intergovernmental transfers. This paper expands the analytical
   perspective of equality of opportunity and offers a novel approach to
   understanding the root causes of urban-rural income disparities.},
