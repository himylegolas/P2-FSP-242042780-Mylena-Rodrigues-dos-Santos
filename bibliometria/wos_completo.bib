Pages = {343-369},
Month = {JUN},
Abstract = {This paper studies the effect of relatively costly local taxation on the
   fiscal response of local governments to intergovernmental transfers.
   Using a panel dataset of Peruvian municipalities, I find robust evidence
   that the central government's grants have a greater stimulatory effect
   in municipalities facing higher local tax collection costs. The results
   are consistent with the hypothesis that relatively costly local taxation
   may partially explain the flypaper effect.},
