@article{ WOS:000310001200004,
Author = {Liberati, Paolo and Sciala, Antonio},
Title = {How economic integration affects the vertical structure of the public
   sector},
Journal = {ECONOMICS OF GOVERNANCE},
Year = {2011},
Volume = {12},
Number = {4},
Pages = {385-402},
Month = {DEC},
Abstract = {This paper investigates the impact of economic integration on the
   vertical structure of the public sector within a country. To tackle this
   issue we set up amodel of fiscal federalism, where economic integration
   is assumed to affect central government tax revenues. The main findings
   are that when an increase of the impact of economic integration brings
   about a reduction in central government tax revenues, under certain
   conditions: (a) it reduces central government expenditure; (b) it
   reduces general government expenditure; (c) it increases local taxation;
   (d) it increases the degree of public sector decentralization. Quite
   interestingly, these results are consistent with different patterns of
   local public spending and grants to local government.},
Publisher = {SPRINGER HEIDELBERG},
Address = {TIERGARTENSTRASSE 17, D-69121 HEIDELBERG, GERMANY},
