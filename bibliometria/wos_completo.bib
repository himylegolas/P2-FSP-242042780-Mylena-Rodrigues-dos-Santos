@incollection{ WOS:000417719200005,
Author = {Akai, Nobuo},
Editor = {Ihori, T and Terai, K},
Title = {Fiscal Consolidation and Local Public Finances in Japan: Incentive
   Problems Associated with Intergovernmental Transfers and Their Political
   Roles},
Booktitle = {POLITICAL ECONOMY OF FISCAL CONSOLIDATION IN JAPAN},
Series = {Advances in Japanese Business and Economics},
Year = {2015},
Volume = {8},
Pages = {95-112},
Abstract = {Japanese local public finances are supported by large intergovernmental
   transfers from the central government. Intergovernmental transfers have
   two roles. The first is to guarantee fiscal standards at local levels.
   The second is to reduce the degree of fiscal inequality among local
   governments. However, both roles induce incentive problems. This chapter
   focuses on the incentive problems associated with intergovernmental
   transfers in Japan and explores how the behavior of politicians in terms
   of designing the transfer system affects this problem.},
