@article{ WOS:000746710300001,
Author = {Liu, Dechun and Zheng, Xinye and Yu, Yihua},
Title = {Public Debt Competition in Local China: Evidence and Mechanism of
   Spatial Interactions},
Journal = {REGIONAL SCIENCE POLICY AND PRACTICE},
Year = {2022},
Volume = {14},
Number = {2, SI},
Pages = {91-105},
Month = {NOV},
Abstract = {While there is abundant theoretical or empirical research on fiscal
   competition in the form of tax or spending competition, little is known
   about public debt competition across local jurisdictions, which
   substantially contributes to growing public debt and, worse, a potential
   local government debt crisis in China. This study provides empirical
   evidence from China on spatial interactions of public debt across local
   governments. Using a provincial panel data set from 1999 to 2016, we
   found that provincial governments engage in strategic interactions via
   local public debt. These findings are robust across several model
   specifications. Further analysis found strong and direct evidence of the
   existence of yardstick competition among local governments on
   debt-issuing behavior.},
