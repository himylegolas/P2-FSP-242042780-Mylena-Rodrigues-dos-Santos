@article{ WOS:001523225400001,
Author = {Rowland, Fernando},
Title = {Impact of New Public Education System over the Achievement of Schools
   and Students in Chile},
Journal = {REVISTA IBEROAMERICANA DE ESTUDIOS MUNICIPALES},
Year = {2025},
Number = {29},
Month = {JAN-DEC},
Abstract = {In 2017 the administration of public schools was transferred from
   municipalities to the Central Government through 21,040 Law creating the
   Local Services of Public Education (SLEP). Nowadays there is no a study
   that measures the impact of this public policy over the attainment of
   schools and students. So, in this work I try to measure the impact using
   data form National Agency of Quality Education and with the
   methodologies of propensity score matching and difference in difference
   (DiD). In general there is a negative impact in the achievement of
   schools and students due the change in the administration, however, in
   some cases there is a positive impact.},
