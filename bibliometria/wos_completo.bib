@article{ WOS:001335552500016,
Author = {Ho, Phan Hai and Tu, Minh Thuan},
Title = {DECENTRALIZATION IN LOCAL GOVERNMENT IN VIETNAM: THE CASE OF HOCHIMINH
   CITY},
Journal = {JOURNAL OF LAW AND POLITICAL SCIENCES},
Year = {2024},
Volume = {42},
Number = {3},
Month = {JUL},
Abstract = {Decentralization is one of the globally prominent concerns in public
   sector reform. Vietnam has implemented decentralization policies since
   1986 with Doi Moi and this process has continuously accelerated in the
   last 30 years with enormous economic achievements. In 2023, the National
   Assembly passed Resolution No. 98/2023/QH15 of June 24, 2023, on
   piloting specific mechanisms and policies for the development of
   Hochiminh city (referred to as Resolution No. 98). This paper aims at
   providing a general understanding of decentralization in Vietnam and
   explains core issues in specific mechanisms and policies in Resolution
   No.98 and analyze difficulties and scale in the development and
   implementation process as well as provide some recommendations for
   Hochiminh city. The findings reveal that despite positive effects on
   Hochiminh city's development under Resolution No.98, there are
   considerable gap between achievements and expectations of the central
   Government and local government due to red tape and limited authority of
   local government. By analyzing and synthesizing secondary documents, the
   author clarifies some of the above content, contributing to providing
   information to help Hochiminh city government better identify
   difficulties and adjust the implementation of Resolution No. 98.},
Publisher = {AL-BAYADER-AL-RAWNAQ NEIGHBORHOOD},
