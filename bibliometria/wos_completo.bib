@article{ WOS:001028027000001,
Author = {Huang, Feipeng},
Title = {How does trade and fiscal decentralization leads to green growth; role
   of renewable energy development},
Journal = {RENEWABLE ENERGY},
Year = {2023},
Volume = {214},
Pages = {334-341},
Month = {SEP},
Abstract = {China has to balance economic growth with environmental protection and
   carbon reduction. This study examines China's 2000-2017 trade, fiscal
   decentralization, renewable energy development, and green growth. To
   understand how these elements affect sustainable and environmentally
   friendly economic growth. We use a panel model to evaluate how trade
   openness and fiscal decentralization affect renewable energy development
   and green growth trade openness boosts renewable energy development and
   green growth in China. Fiscal decentralization also promotes renewable
   energy and local economic growth. These findings emphasize trade
   liberalization and fiscal decentralization as policy levers for green
   growth through renewable energy development. Policymakers should promote
   international economic integration and give local governments more
   authority and fiscal incentives to embrace and expand renewable energy
   technologies. This research helps policymakers understand green growth
   in China and promote sustainable economic development while addressing
   environmental issues.},
