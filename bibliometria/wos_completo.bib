   Bulut-Cevik, Zeynep Burcu, Ankara Yildrim Beyazit Univ, Dept Publ Finance, Ankara, Turkey.},
DOI = {10.17233/sosyoekonomi.2020.02.06},
ISSN = {1305-5577},
Keywords = {Fiscal Decentralization; Fiscal Centralization; Intergovernmental
   Transfer/Redistribution Rule; Welfare; Capital Mobility},
Keywords-Plus = {ECONOMIC-GROWTH; TAX COMPETITION; POLITICAL-ECONOMY; COUNTRIES;
   LEVIATHAN; TAXATION; POLICY},
