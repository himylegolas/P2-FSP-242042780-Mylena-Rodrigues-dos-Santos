@article{ WOS:000898454600009,
Author = {Calabrese, Stephen and Epple, Dennis and Romano, Richard},
Title = {Majority choice of taxation and redistribution in a federation},
Journal = {JOURNAL OF PUBLIC ECONOMICS},
Year = {2023},
Volume = {217},
Month = {JAN},
Abstract = {To study redistribution and taxation in a federation, we provide a model
   with a central government and multiple local governments, the former
   with power to levy an income tax for redistribution, and the latter
   choosing a local income tax, property tax, lump-sum tax or subsidy, and
   a local public good. Policy is set by majority choice at each tier of
   government by households that differ by income and by ability to move
   among local jurisdictions. We provide sufficient conditions for
   existence of equilibrium and examine its properties. Central findings
   are federal income distribution, little local redistribution, and local
   preference for property taxation over income taxation to fund local
   public goods.(c) 2022 Elsevier B.V. All rights reserved.},
