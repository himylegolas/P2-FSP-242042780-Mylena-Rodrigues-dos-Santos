@article{ WOS:000447314400002,
Author = {Badrudin, Rudy and Kusuma, Manggar Wulan and Wardani, Ranti Yulia},
Title = {The inclusive economic development model in Sulawesi island},
Journal = {ECONOMIC JOURNAL OF EMERGING MARKETS},
Year = {2018},
Volume = {10},
Number = {2},
Pages = {128-136},
Month = {OCT},
Abstract = {This study aims to determine whether there is an inclusive economic
   development in Sulawesi Island. Data used are secondary data sourced
   from the financial statements of the Local Government regency and city
   in Sulawesi Island in 2009-2016. The data analysis technique used is
   Partial Least Square which tested on nine different sample areas. The
   results showed that general allocation fund and own source revenue have
   positive effect on capital expenditure. The capital expenditure has
   positive effect on economic growth. However, the economic growth has
   negative effect on welfare of society and poverty.},
