Volume = {41},
Number = {1},
Pages = {51-74},
Month = {SPR},
Note = {International Seminar on Fiscal Federalism and Federal Finance, UNIV
   NACL CORDOBA, CORDOBA, ARGENTINA, JUN, 1996},
Abstract = {Canadians are all too aware of such effects of ``federal finance{''} as
   the impact of federal deficit-cutting on provincial and local
   governments. Economists have a well-developed theory of ``fiscal
   federalism{''} that they commonly use to analyse problems of multilevel
   finance. Are ``federal finance{''} and ``fiscal federalism{''} just
   different names for the same thing? This paper argues that the two
   concepts differ in some important key respects and illustrate our
   argument in terms of marked contrasts in developments at the
   federal-provincial and provincial-municipal levels with respect to
   taxes, transfers and borrowing.},
