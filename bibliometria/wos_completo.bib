@article{ WOS:001491912200007,
Author = {Pham, My Hang Phuong and Dang, Nhung Thuy},
Title = {FISCAL DECENTRALIZATION: THE CASE OF VIETNAM},
Journal = {VOPROSY GOSUDARSTVENNOGO I MUNITSIPALNOGO UPRAVLENIYA-PUBLIC
   ADMINISTRATION ISSUES},
Year = {2025},
Number = {5},
Pages = {106-130},
Abstract = {This study analyzes fiscal decentralization in Vietnam from 2003 to 2023
   by examining budget data for the central government and its 63
   provinces. During this period, Vietnam underwent significant reforms to
   the State Budget Law, aiming to enhance local governments autonomy. The
   2015 law marked a pivotal point, establishing a framework for
   decentralized budget management characterized by stability,
   transparency, and local initiative while maintaining central oversight.
   Consequently, Vietnam has made strides in decentralizing revenue and
   expenditure, diminishing reliance on central transfers. However, the
   process is not yet completed, as certain budgetary functions are still
   highly centralized. To have a comprehensive picture of fiscal
   decentralization, future research should expand the scope to assess
   fiscal decentralization within the context of administrative and
   political decentralization to gain a more comprehensive understanding of
   its true nature and impact.},
