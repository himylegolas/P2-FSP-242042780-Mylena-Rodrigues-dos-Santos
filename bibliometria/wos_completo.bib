@article{ WOS:001874647800001,
Author = {Gao, Bei and Chen, Lihuan and Zhu, Jingrui},
Title = {Fiscal decentralization and artificial intelligence innovation: evidence
   from Chinese listed A-share firms},
Journal = {APPLIED ECONOMICS LETTERS},
Year = {2026},
Month = {2026 SEP 13},
Abstract = {Using panel data for Chinese A-share listed firms from 2009 to 2023,
   this study finds a positive association between fiscal decentralization
   and corporate AI innovation. This association operates through greater
   local government S\&T expenditure, stronger talent acquisition, and
   business environment improvements. The effect is stronger for
   non-state-owned enterprises, firms facing lower financing constraints,
   firms with an existing AI foundation, and firms in regions where local
   officials face lower promotion pressure. Moreover, local government AI
   attention strengthens this relationship, whereas local government
   competition weakens it.},
