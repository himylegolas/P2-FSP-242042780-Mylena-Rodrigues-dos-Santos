@article{ WOS:001865349600001,
Author = {Zhu, Z. X. and T Zhao, Z.},
Title = {THE EFFECTS OF FISCAL AND ENVIRONMENTAL DECENTRALIZATION ON
   ENVIRONMENTAL PROTECTION: A BIBLIOMETRIC ANALYSIS},
Journal = {APPLIED ECOLOGY AND ENVIRONMENTAL RESEARCH},
Year = {2026},
Month = {2026 JUN 11},
Abstract = {Fiscal decentralization (FD) and environmental decentralization (ED)
   play an important role in shaping local governments' incentives and
   actions toward environmental protection (EP). While existing studies
   have predominantly relied on empirical approaches to examine the
   relationships among FD, ED, and EP, less attention has been paid to the
   overall knowledge structure and evolutionary trajectory of this research
   field. To address this gap, this study employs a bibliometric approach
   to systematically review the FD-ED- EP literature and to examine how
   these decentralization mechanisms have been studied across different
   contexts. Using a dataset of 2,103 publications retrieved from the Web
   of Science, this study applies CiteSpace and COOC to map the knowledge
   base, major research domains, and thematic evolution of the field. The
   results identify three main research areas: empirical studies on the
   FD-ED-EP nexus, local government environmental behavior, and China's
   distinctive fiscal and environmental decentralization systems. The
   analysis further reveals the evolution of key topics and keywords,
   highlighting emerging themes and influential research directions. In
   addition, the existing literature is classified according to empirical
   research types and theoretical foundations. The findings also point to
   two major gaps in the current literature: limited multinational and
   cross-cultural collaboration, and insufficient integrated and holistic
   analysis. Future research should therefore strengthen transnational
   cooperation and develop more comprehensive analytical frameworks to
   advance understanding of the role of decentralization in environmental
   protection.},
