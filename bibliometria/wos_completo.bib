@article{ WOS:001041538700012,
Author = {de Souza, Valter Marques Reis and Moreira, Romilson do Carmo and de
   Souza, Jorge Adriano Ferreira and Pacheco, Rubens Mario Ribeiro},
Title = {The effects of fiscal management instruments on the social development
   of municipalities in Bahia},
Journal = {REVISTA DE GESTAO E SECRETARIADO-GESEC},
Year = {2023},
Volume = {14},
Number = {7},
Pages = {11828-11850},
Abstract = {This study aims to examine the impact of municipal public management
   indicators, based on the Fiscal Responsibility Law (LRF), on the
   development indicators of municipalities. The objective is to assess the
   effect of fiscal management instruments and their implications for
   enhancing social development in municipalities. The methodology employed
   is based on the assumptions of Panel Data Estimation models for the 417
   municipalities in the state of Bahia, covering the years 2013 to 2016.
   The findings reveal significant statistical evidence for certain fiscal
   management indicators, indicating that municipalities with positive
   fiscal management outcomes demonstrate better indicators of social
   development.},
