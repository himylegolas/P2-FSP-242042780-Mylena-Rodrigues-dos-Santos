@article{ WOS:A1994PE91200007,
Author = {HEYNDELS, B and SMOLDERS, C},
Title = {FISCAL ILLUSION AT THE LOCAL-LEVEL - EMPIRICAL-EVIDENCE FOR THE FLEMISH
   MUNICIPALITIES},
Journal = {PUBLIC CHOICE},
Year = {1994},
Volume = {80},
Number = {3-4},
Pages = {325-338},
Month = {SEP},
Abstract = {Fiscal illusion refers to a systematically biased perception of fiscal
   parameters, due to demand-side error/ignorance or supply-side abusive
   behaviour. As such it is a component of a more general tax choice
   framework.
   This paper focuses predominantly on the empirical estimation of the four
   major sources of fiscal illusion, namely the flypaper effect, renter
   illusion and the complexity and elasticity of tax systems. The results -
   based on a dataset of 302 Flemish municipalities - on balance suggest
   the existence of important illusionary effects.},
