Year = {2022},
Volume = {31},
Number = {4},
Abstract = {This study analyzes the reality of public health financing, focusing on
   the municipalities of southern Bahia, based on the right to health. To
   do so, it presents the political and administrative organization of the
   Brazilian State, understood as a tool for ensuring the effectiveness of
   fundamental rights, always in line with the principle of human dignity.
   All the analysis were conducted using empirical data on fund raising and
   expenditure, mainly referring to the municipalities from the Southern
   Coast of Bahia.},
