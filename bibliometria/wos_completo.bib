@article{ WOS:000831733500009,
Author = {Karaer, Abdullah},
Title = {Fiscal Rule Applications in Sub-Central Governments and a Review of
   Turkey},
Journal = {MALIYE DERGISI},
Year = {2022},
Number = {182},
Pages = {179-208},
Month = {JAN-JUN},
Abstract = {Fiscal rules are numerical or procedural regulations that limit the
   increase in budget deficits, public expenditures, public debt and public
   revenues. These rules aim to increase the accountability and fiscal
   transparency of public administrations and to ensure fiscal
   sustainability. The aim of this study is to examine the fiscal rules
   applied at the sub-central government level in the world and to analyze
   the effects of these rules on the fiscal structures of local
   administrations in Turkey. At the end of the study, it is concluded that
   municipalities in our country indirectly exceed the fiscal rules
   regarding personnel expenditures especially through municipal companies,
   the principles of budget unity and generality cannot be applied in
   municipalities, and the fiscal rules regarding borrowing are
   insufficient to prevent excessive increase in the total debt stock of
   municipalities. For this reason, suggestions for the solution of these
   problems are presented in the study.},
