@article{ WOS:A1996VY64000003,
Author = {Wei, YH},
Title = {Fiscal systems and uneven regional development in China, 1978-1991},
Journal = {GEOFORUM},
Year = {1996},
Volume = {27},
Number = {3},
Pages = {329-344},
Month = {AUG},
Note = {92nd Annual Meeting of the Association-of-American-Geographers,
   CHARLOTTE, NC, APR 09-13, 1996},
Organization = {Assoc Amer Geographers},
Abstract = {This paper investigates China's changing fiscal system and its impact on
   uneven regional development. It reveals that Mao's fiscal system was
   featured by centralized revenue collection and inter-regional budget
   transfers, giving few incentives to the provinces. Post-Mao China has
   partially changed Mao's fiscal system, mainly through the introduction
   of the contracting system and fiscal decentralization. Fiscal
   decentralization has reduced the fiscal control of the central
   government and given the provinces more autonomy and incentives in
   economic development. However, the decentralization of expenditure
   responsibilities has been slower than that of revenue generation and
   market-oriented adjustment mechanisms have not been successfully
   established. Moreover, the provinces were not equally treated by the
   central government in revenue sharing and tax collection. The coastal
   provinces such as Guangdong and Fujian received more preferential fiscal
   policies while the three provincial-level municipalities of Shanghai,
   Beijing and Tianjin were still tightly controlled. The proliferation of
   extrabudgetary funds has further differentiated the provinces in local
   spending. Different fiscal systems in different provinces have
   significantly contributed to uneven regional development in post-Mao
   China where some coastal regions experienced dramatic growth while
   others fell behind. Copyright (C) 1996 Elsevier Science Ltd},
