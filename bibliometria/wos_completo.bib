@article{ WOS:001419036600008,
Author = {Vieira, Edson Trajano and da Silva, Ernesto Donizetti Aparecido},
Title = {PUBLIC RESOURCES: THE PARTICIPATION OF ROYALTIES IN THE ECONOMIC
   DEVELOPMENT OF MUNICIPALITIES ON THE NORTH COAST OF THE STATE OF SAO
   PAULO},
Journal = {REVISTA UNIVAP},
Year = {2024},
Volume = {30},
Number = {69},
Abstract = {After the 1988 Constitution, Brazil experienced changes in fiscal
   federalism, decentralizing revenues to states and municipalities, but
   the restrictive federal fiscal scenario limited this. Law 9,478/97
   increased royalty revenues for coastal municipalities in Sao Paulo,
   boosting investments in infrastructure and public services, which should
   be directed towards investments that consider the potential of each
   municipality. To conduct this study, we used exploratory research of a
   qualitative nature, with a bibliographic and documentary design. This
   study investigates the impact of these resources on tax revenues and
   economic development in the municipalities of S \& atilde;o Sebasti \&
   atilde;o and Ilhabela, concluding that, although they have boosted
   investments and public services, the lack of strategic direction could
   compromise the economic future of these regions},
