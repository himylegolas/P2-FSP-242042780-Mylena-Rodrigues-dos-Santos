@article{ WOS:001554151300001,
Author = {Liu, Zhuoxuan and Zhong, Hai and Zhen, Dongyang},
Title = {Fiscal decentralization and land urbanization: evidence from China's
   fiscal reform of ``province-managing-county{''}},
Journal = {POLICY STUDIES},
Year = {2025},
Month = {2025 AUG 20},
Abstract = {Fiscal decentralization plays a pivotal role in shaping urban
   development across countries, influencing subnational governments'
   incentives and capacities in land use and infrastructure provision. This
   study focuses on China, where local governments, driven by political
   incentives, economic imperatives, and evolving intergovernmental fiscal
   arrangements, have played a central role in promoting land urbanization.
   Leveraging a quasi-natural experiment based on the
   province-managing-county (PMC) reform, we identify the causal impact of
   reduced urban fiscal authority (or negative fiscal decentralization) on
   land urbanization. We measure land urbanization using nighttime
   luminosity data to delineate urban boundaries and conduct empirical
   analysis with panel data from prefecture-level cities spanning
   2001-2020. Our findings show that the PMC reform hindered land
   urbanization, mainly by reducing fiscal power and increasing fiscal
   pressures, which limited prefectural governments' resources and
   authority to foster expansion. Additionally, this effect is more
   pronounced with the rising of fiscal pressure. In contrast, regions with
   higher levels of economic growth, stronger fiscal positions, and greater
   agglomeration benefits experienced a mitigated negative effect. Our
   results ultimately support the argument that fiscal decentralization
   facilitates urban expansion.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
