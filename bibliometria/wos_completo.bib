@article{ WOS:000708090700003,
Author = {Fabre, Brice},
Title = {POLITICAL COLLEAGUES MATTER: THE IMPACT OF MULTIPLE OFFICE-HOLDING ON
   INTERGOVERNMENTAL GRANTS},
Journal = {REVUE ECONOMIQUE},
Year = {2021},
Volume = {72},
Number = {5},
Pages = {799-842},
Month = {SEP},
Abstract = {This paper brings new evidence on the politics of intergovernmental
   grants, by focusing on multiple office-holding (cumul des mandat). I
   look at whether a local incumbent who has concurrently a seat at an
   upper layer of government gets more funds from this layer. I focus on
   grants counties (departements) allocate to municipalities. I find that
   mayors who also have a seat in the majority group of the county council
   get on average 28\% more grants for their municipality than other
   municipal incumbents. Additional evidence suggest this targeting being
   driven by reelection concerns of county councillors.},
Publisher = {PRESSES FOND NAT SCI POLIT},
Address = {27 RUE SAINT-GUILLAUME, 75341 PARIS 07, FRANCE},
Type = {Article},
Language = {French},
Affiliation = {Fabre, B (Corresponding Author), PSE Ecole Econ Paris, 48 Blvd Jourdan, F-75014 Paris, France.
   Fabre, Brice, Inst Polit Publ IPP, Paris, France.},
DOI = {10.3917/reco.725.0799},
ISSN = {0035-2764},
EISSN = {1950-6694},
Keywords = {intergovernmental transfers; multiple office-holding; regression
   discontinuity design},
Keywords-Plus = {REGRESSION DISCONTINUITY DESIGN; EMPIRICAL-EVIDENCE; PARTIES MATTER;
