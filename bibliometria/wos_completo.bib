@article{ WOS:001313601700001,
Author = {Miao, Yongming and Li, Yaokuang and Wu, Yanrui},
Title = {Digital economy and economic competitive pressure on local governments:
   Evidence from China},
Journal = {ECONOMIC MODELLING},
Year = {2024},
Volume = {140},
Month = {NOV},
Abstract = {For decades, fiscal decentralization and gross domestic product growth
   targeting have resulted in fierce economic competition among local
   governments in China, putting tremendous economic competitive pressure
   on them. The latter has serious social and economic implications and is
   a major issue for policymakers. This study analyzes data from China's 30
   provinces for 2011-2021. It demonstrates that digital economic
   development could considerably reduce economic, competitive pressure on
   local governments, with trade openness and entrepreneurial dynamism
   serving as impact mechanisms. This study also found that the alleviating
   effects are more pronounced in regions with a poor innovation
   environment, a less developed economy, or lagging human resources. These
   findings emphasize the important role of the digital economy in
   increasing regional competitiveness and reducing regional disparities.},
