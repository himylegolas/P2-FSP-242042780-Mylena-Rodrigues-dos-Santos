@article{ WOS:001041219900006,
Author = {Cukur, Asuman},
Title = {The Impact of Fiscal Decentralization on Local Fiscal Discipline: The
   Case of Turkey},
Journal = {MALIYE DERGISI},
Year = {2023},
Number = {184},
Pages = {116-144},
Month = {JAN-JUN},
Abstract = {The goal of this study is to examine the effects of fiscal
   decentralization on the local governments' fiscal discipline in Turkey.
   Partial fiscal decentralization as in our country, can create asymmetry
   between local government expenditures and local governments' own
   revenues. It is argued in the fiscal decentralization theory that
   financing the expenditures of local governments from their own revenues
   increases fiscal discipline. Based on the provincial level data over
   2009-2020, the effects of the partial fiscal decentralization on the
   local governments' fiscal discipline were analyzed with different fiscal
   decentralization indicators such as revenue decentralization which is
   based on the local own revenues as well as vertical fiscal imbalances
   (VFI) using different models including two-step System GMM. The results
   of the analysis find that higher revenue decentralization leads to
   greater fiscal discipline in Turkey while vertical fiscal imbalances
   decreases fiscal discipline of local governments.},
Publisher = {MALIYE BAKANLIGI},
Address = {MALIYE BAKANLIGI, ANKARA, 00000, Turkiye},
