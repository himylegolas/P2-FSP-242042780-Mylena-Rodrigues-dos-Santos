@article{ WOS:001730679700001,
Author = {Cai, Jialiang},
Title = {The political economy of local autonomy, economic growth, and social
   harmony: A focus on the perspectives of local government officials},
Journal = {CRIME LAW AND SOCIAL CHANGE},
Year = {2026},
Volume = {84},
Number = {1},
Month = {APR 1},
Abstract = {This paper examines the political economy of local autonomy and its
   impact on economic growth and social harmony at the local government
   level in China. Focusing on the perspectives of local government
   officials, the study examines how decentralization and increased local
   autonomy impact governance outcomes. Using a mixed-methods approach, the
   paper combines panel data regression to assess economic indicators, such
   as local GDP and employment rates, with qualitative insights from
   interviews with local officials. The findings reveal a positive
   relationship between local autonomy and economic growth, with investment
   levels and employment rates significantly improving in cities with
   higher autonomy. However, the paper also finds that the quality of local
   governance has a more significant influence on social cohesion than
   autonomy alone. Moreover, the perceptions of local officials play a
   critical moderating role in determining the success of decentralization.
   The study emphasizes the importance of empowering local governments
   while maintaining robust governance practices to achieve sustainable
   economic and social outcomes.},
