Title = {Fiscal Decentralization and Efficiency of Regional Government in
   Croatia: A Data Envelopment Analysis},
Journal = {LEX LOCALIS-JOURNAL OF LOCAL SELF-GOVERNMENT},
Year = {2019},
Volume = {17},
Number = {3},
Pages = {453-470},
Month = {JUL},
Abstract = {To determine the efficiency of regional and local government public
   functions, the most used method in the empirical analysis is data
   envelopment analysis. This paper reviews 20 counties as part of regional
   government units in Croatia as well as the relationship between
   efficiency scores and exogenous determinants in the 2009-2016 period.
   The results of our analysis show that, among exogenous determinants,
   only the annual registered unemployed rate and annual average wage for
   full time jobs are statistically significant.},
