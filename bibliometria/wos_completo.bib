@article{ WOS:001899368000002,
Author = {Qian, Weijin and Mu, Jinyao},
Title = {Race to the top or bottom? Asymmetric strategic interactions in China's
   urban digital economy},
Journal = {ANNALS OF REGIONAL SCIENCE},
Year = {2026},
Volume = {75},
Number = {4},
Month = {OCT 9},
Abstract = {While China's digital economy has expanded rapidly, its development is
   marked by significant regional disparities driven by complex inter-local
   government competition. Existing studies rely on average spatial
   responses, leaving asymmetries across competitive conditions unclear.
   This study examines fiscal decentralization as the institutional basis
   of local fiscal capacity and policy discretion and assesses its
   association with urban digital economy development. Within this setting,
   it tests whether intercity strategic interactions vary with neighboring
   performance and a city's relative position. Using panel data for 285
   Chinese cities during 2011-2022, we combine Moran's I, benchmark
   regressions, a single-regime Spatial Durbin Model with effect
   decomposition, and two-regime spatial models. Urban digital development
   remained positively spatially associated. Under the economic distance
   matrix, Moran's I declined from 0.3169 to 0.2799 between 2011 and 2022.
   Across four specifications, fiscal decentralization was positively
   associated with a city's own digital development, with estimated effects
   of 0.0087-0.0225. Its estimated association with neighboring cities'
   digital development was also positive, but was not significant under the
   economic distance matrix. These average relationships concealed
   asymmetric responses. Under geographic, economic-geographic, and
   contiguity links, local outcomes co-moved with peers whether neighboring
   performance declined or not. This indicates conditional downward and
   upward responses, consistent with ``race to the bottom{''} and ``race to
   the top{''} patterns. Economic distance responses were narrower,
   emerging only when a city did not lead its peers. This conditionality
   was also regional: responses were broader in eastern and central cities
   but confined to selected links and states in western cities. These
   findings suggest that coordination policies should reflect fiscal
   capacity, intercity connectivity, competitive conditions, and regional
   context.},
