@article{ WOS:000397574800007,
Author = {Munoz, Andres},
Title = {Strategic Fiscal Interaction among Local Governments in Colombia},
Journal = {HACIENDA PUBLICA ESPANOLA-REVIEW OF PUBLIC ECONOMICS},
Year = {2016},
Number = {219},
Abstract = {This study tests for the presence of strategic fiscal interaction among
   municipal governments in Colombia, specifically in tax setting, and
   attempts to identify its source. Using spatial panel data from most
   municipalities for the period 2000-09, this paper provides empirical
   evidence of the existence of strategic interactions in property and
   business taxation. However, there is little evidence of cut-throat tax
   competition that leads to a ``race to the bottom.{''} Also, this paper
   shows that differences in property tax rates affect local election
   results and the popularity of the main political parties in the local
   councils, signaling the presence of yardstick competition in this
   source. Such electoral effects of strategic tax setting are not present
   in business taxation. The results suggest that cut-throat tax
   competition is not a general concern in Colombia. Thus the country does
   not seem to require policy measures aimed at attenuating municipal tax
   competition and, if implemented, they are likely to be ineffective.},
Publisher = {INST ESTUDIOS FISCALES},
Address = {AVDA CARDENAL HERRERA ORIA, 378, MADRID, 28035, SPAIN},
