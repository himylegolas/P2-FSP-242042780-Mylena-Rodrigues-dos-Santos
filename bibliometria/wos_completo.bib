   Kim, Mingon, Hanyang Womens Univ, Dept Publ Adm, Seoul, South Korea.
   Park, Ji Hyung, Soongsil Univ, Dept Publ Adm, Seoul, South Korea.
   Park, HyungGun, SungKyunKwan Univ, Inst Governance \& Policy Evaluat, Seoul, South Korea.},
DOI = {10.1080/17516234.2020.1858706},
