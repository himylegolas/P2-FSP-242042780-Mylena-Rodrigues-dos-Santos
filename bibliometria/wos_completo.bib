@article{ WOS:001142049300001,
Author = {Lago, Manuel E. and Lago-Penas, Santiago and Martinez-Vazquez, Jorge},
Title = {On the effects of intergovernmental grants: a survey},
Journal = {INTERNATIONAL TAX AND PUBLIC FINANCE},
Year = {2024},
Volume = {31},
Number = {3},
Pages = {856-908},
Month = {JUN},
Abstract = {This paper offers a comprehensive and updated review of the effects of
   intergovernmental grants. We focus on the main findings in the existing
   literature on the effects of intergovernmental grants on tax policy and
   choices, expenditure decisions, fiscal stability and behavioral choices,
   and political economy. The intricate nature of the subject,
   intrinsically, does not allow for an all-inclusive survey, but we aim to
   provide a thorough examination and update of the most salient effects of
   intergovernmental grants, while indicating areas for further research.},
