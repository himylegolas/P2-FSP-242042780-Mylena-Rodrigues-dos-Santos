@article{ WOS:001901891200001,
Author = {Laino-de-Castro, Juan Jose and Caamano-Alegre, Jose and Lopez-Iglesias,
   Edelmiro},
Title = {When a biased index of tax effort instils regional inequity in the local
   financing system: findings from a DEA on rural municipalities of Spain},
Journal = {COGENT ECONOMICS \& FINANCE},
Year = {2026},
Volume = {14},
Number = {1},
Month = {DEC 31},
Abstract = {This study provides a DEA-based measure of the municipal tax effort
   (MTE) of rural towns in Spain, against whose results the adequacy of the
   country's MTE index used for transfer allocation is assessed. The
   results confirm that a low average MTE relative to the frontier is a
   structural feature of such towns. They also suggest that the country's
   official MTE index partly reflects differences in tax capacity, thereby
   overestimating the MTE of high-income regions while underestimating that
   of relatively poor ones. Indeed, the tax effort criterion for allocating
   transfers effectively acts as a pro-rich counterweight to the (inverse)
   tax capacity criterion, which favors poor towns. Although questionable
   in terms of equity, this can be explained from a political economy
   approach. Moreover, the switch to an unbiased MTE index would be costly
   if a `status quo clause' were to be applied.
   In the academic literature on intergovernmental transfers and
   equalization grants, one relevant topic is the possible disincentivizing
   effect of these mechanisms on the tax efforts of subnational
   governments. To prevent this moral hazard, distribution schemes for
   vertical transfers are often based on fiscal capacity instead of actual
   revenues. Moreover, some schemes include tax effort as a criterion for
   distribution; this is the case in Spain as regards the central
   government's scheme for general transfers to municipalities, which
   employs a municipal tax effort indicator calculated by the Ministry of
   Finance. To assess the potential biases of this indicator vis-\&
   agrave;-vis rural municipalities, we construct an alternative measure of
   tax effort through data envelopment analysis (DEA). Our research bundles
   both relative homogeneity and notable size into the sample, bearing in
   mind outlier identification and testing the existence of constant versus
   variable returns of scale. Analysis of the average regional results
   shows that the Ministry's indicator tends to overestimate the municipal
   tax effort in regions with high per capita income, such as the Balearic
   Islands, Catalonia, and Madrid. At the same time, it underestimates the
   tax effort in relatively poor regions. By taking as differences in tax
   effort what are in fact differences in tax effort and capacity, the
   Ministry's indicator shows greater disparity in tax efforts between
   regions than is actually the case. Significant policy implications may
   be drawn from these findings.},
