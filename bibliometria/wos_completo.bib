@article{ WOS:001828261600002,
Author = {Yan, Jing and Chen, Wenbin and Yao, Xin},
Title = {Fiscal decentralization and energy intensity: Evidence from China's
   fiscal reform of ``Provincial Management of Counties{''}},
Journal = {JOURNAL OF ASIAN ECONOMICS},
Year = {2026},
Volume = {105},
Month = {SEP},
Abstract = {Under fiscal decentralization, local government conduct and regional
   development strategies are key factors shaping the balance between
   economic growth and energy consumption. This study employs a
   multi-period Difference-in- Differences (DID) model to identify the
   causal impact of the ``Provincial Management of Counties{''} (PMC)
   fiscal reform on county-level energy intensity. The results show that
   the implementation of the PMC reform effectively reduces county-level
   energy intensity. Specifically, the reform delivers this reduction by
   boosting county-level innovation capacity, fostering economic
   agglomeration, and optimizing industrial structure. Moreover, the
   negative impact is more pronounced in regions with lower resource
   dependence, stronger environmental regulation, and weaker fiscal
   self-sufficiency. These findings provide a new perspective for
   evaluating the effectiveness of fiscal decentralization.},
