@article{ WOS:000230565800002,
Author = {Oates, WE},
Title = {Toward a second-generation theory of fiscal federalism},
Journal = {INTERNATIONAL TAX AND PUBLIC FINANCE},
Year = {2005},
Volume = {12},
Number = {4},
Pages = {349-373},
Month = {AUG},
Abstract = {Drawing on a wide range of literature and ideas, a new
   ``second-generation theory of fiscal federalism{''} is emerging that
   provides new insights into the structure and working of federal systems.
   After a restatement and review of the first-generation theory, this
   paper surveys this new body of work and offers some thoughts on the ways
   in which it is extending our understanding of fiscal federalism and on
   its implications for the design of fiscal institutions.},
