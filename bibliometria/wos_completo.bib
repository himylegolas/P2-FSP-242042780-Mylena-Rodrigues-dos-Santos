@article{ WOS:000167850600005,
Author = {Toboso, F},
Title = {First quantitative analysis of territorial organization of government
   functions in Spain, Germany and Switzerland},
Journal = {TRIMESTRE ECONOMICO},
Year = {2001},
Volume = {68},
Number = {270},
Pages = {269-304},
Month = {APR-JUN},
Abstract = {The basic purpose of this article is to show the degree of fiscal
   decentralization achieved in Spain since democratic transition in 1978
   concerning both public expenditures and tax powers. The situation
   characterising regional and local governments in Germany and Switzerland
   is used as a bench mark in order to make qualitative and quantitative
   comparisons based on national account IMF figures. Though Spain can be
   described now as a politically decentralized country in which the
   distribution of functions and the system of governance in general are
   close to those of a federal state, the paper concludes that a lack of
   financial autonomy characterises the making of the Spanish state of the
   autonomous communities (regional governments). A high degree of tax
   uniformity along communities has remained as a consequence, though the
   said regional governments enjoy a lower degree of financial autonomy
   than both the regional governments existing in Germany and Switzerland
   and the Spanish local governments.},
