@article{ WOS:000380065300012,
Author = {Zhang, Shujian},
Title = {Fiscal Decentralization, Budgetary Transparency, and Local Government
   Size in China},
Journal = {EMERGING MARKETS FINANCE AND TRADE},
Year = {2016},
Volume = {52},
Number = {7},
Pages = {1679-1697},
Abstract = {This article makes use of panel data for 31 provinces between 1985 and
   2010 and specifies a dynamic panel model to investigate the determinants
   of local government size in China and achieved several conclusions: (1)
   the fiscal decentralization since TSS reform in 1994 has increased the
   local government size; (2) budgetary transparency has a U-shape
   nonlinear effect on local government size; (3) fiscal revenue is the
   important factor to drive the overexpansion of local government size in
   China; and (4) local government size has a strong dependence of past
   path.},
