@article{ WOS:000658444500001,
Author = {Athias, Diloa and Schneider, Rodrigo},
Title = {The impact of political representation on the provision of public goods
   and services},
Journal = {FISCAL STUDIES},
Year = {2021},
Volume = {42},
Number = {2},
Pages = {367-381},
Month = {JUN},
Abstract = {In this paper, we investigate the impact of political representation in
   Congress in Brazil on the local provision of public goods and services.
   Relying on a fixed effects model, plus the fact that the electoral
   system generates some random variation in the political representation
   across terms and municipalities, we find a positive and significant
   effect of political representation on health and school outcomes. For
   instance, in health, the results indicate that one additional seat in
   Congress representing a municipality decreases the share of low birth
   weight newborns by 0.06 percentage points. When looking at school
   outcomes, the share of schools with access to the Internet increases by
   0.63 percentage points. Moreover, the results suggest that `pork-barrel'
   politics is one potential mechanism explaining this improvement in the
   provision of public goods and services.},
