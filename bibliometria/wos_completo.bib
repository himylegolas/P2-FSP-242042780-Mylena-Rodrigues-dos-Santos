@article{ WOS:001840749800011,
Author = {Hurtado, Ricardo Andres Reveco and Rodrigues, Leandro Menezes and
   Barros, Claudio Marcelo Edwards},
Title = {Economic Policy Uncertainty and Cash Holdings in Brazilian States and
   The Federal District},
Journal = {ADMINISTRACAO PUBLICA E GESTAO SOCIAL},
Year = {2026},
Volume = {18},
Number = {2},
Month = {APR-JUN},
Abstract = {Research objective: To investigate the relationship between economic
   policy uncertainty and cash holdings in Brazilian states and the Federal
   District, considering the stabilizing role of intergovernmental
   transfers. Theoretical framework: Grounded in the literature on
   liquidity management and financial precaution (Opler et al., 1999; Gore,
   2009; Bloom, 2014), this study links the concept of Economic Policy
   Uncertainty (Baker et al., 2016) to public resource management.
   Methodology: Quantitative research using balanced panel data from 27
   federative units between 2003 and 2020. Multiple regressions were
   applied under the GMM-Sys (two-step) approach, controlling endogeneity,
   electoral effects, and fiscal heterogeneity. Results: The findings do
   not confirm the hypothesis of a positive relationship between economic
   policy uncertainty and cash holdings. The results indicate that the
   effects of uncertainty may be mitigated by federal transfers and fiscal
   diversity among states, reducing the sensitivity of local government
   finances to variations in uncertainty. Originality: This study is
   pioneering in examining cash holdings through the lens of Economic
   Policy Uncertainty in the Brazilian public sector, extending a
   predominantly corporate research agenda to the field of public
   management. Theoretical and practical contributions: Empirical evidence
   challenges assumptions from corporate literature, suggesting that the
   stabilizing role of fiscal federalism mitigates the need for
   precautionary cash retention among state governments. The results
   provide insights for managers and policymakers in understanding the
   determinants of public liquidity in contexts of uncertainty.},
