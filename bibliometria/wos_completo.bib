@article{ WOS:001852671500001,
Author = {Ghosh, Avik},
Title = {Gender and urban fiscal governance: evidence from female leadership in
   Indian municipal corporations},
Journal = {LOCAL GOVERNMENT STUDIES},
Year = {2026},
Month = {2026 AUG 20},
Abstract = {Urban local bodies control 60-65\% of India's municipal revenues, making
   them central to democratic decentralisation. Despite their fiscal
   importance, women's leadership impact in Municipal Corporations remains
   unexplored. Existing research focuses on rural panchayats or national
   gender budgeting, leaving a critical urban governance gap. This study
   constructs a novel dataset linking leadership information for 204 MCs
   with budget data for 171 corporations, complemented by Reserve Bank
   aggregate data. Using two-way fixed effects, instrumental variables, and
   staggered difference-in-differences, it finds that female leaders are
   associated with larger total budgets, enhance revenue mobilisation, and
   reallocate expenditures towards service-oriented categories. Dynamic
   estimates reveal budgetary shifts materialise within the first year of
   assuming office. They confirm that descriptive representation translates
   into substantive fiscal outcomes through preference substitution,
   accountability signalling, and risk-averse capital management. By
   tracing these three mechanisms, the paper links representative
   bureaucracy theory to the political economy of distributive preferences.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
