@article{ WOS:001796777300001,
Author = {Zhou, Yicheng and Song, Malin and Ouyang, Wenjie},
Title = {Fiscal path to green development: Impact of vertical fiscal imbalance on
   urban green technological innovation in China☆},
Journal = {INTERNATIONAL REVIEW OF FINANCIAL ANALYSIS},
Year = {2026},
Volume = {117},
Month = {SEP},
Abstract = {The fiscal decentralization (FD) system focuses on the motivation and
   ability of local governments to supply public goods and promote green
   development. However, the significant role of vertical fiscal imbalance
   (VFI) in green technological innovation (GTI) requires further
   exploration. This paper discusses the fiscal institutional background of
   urban GTI from the perspective of VFI. Using panel data on Chinese
   cities from 2004 to 2019, this study empirically examines the impact of
   VFI on GTI, and tests the nonlinear relationship of FD, VFI, and GTI.
   The results show that a higher VFI is associated with a decrease in
   urban GTI. The VFI-GTI association exhibits heterogeneity due to
   resource endowment, economic level and geographical location. Meanwhile,
   fiscal revenue decentralization and expenditure decentralization are
   positively associated with urban GTI, but the green innovation effect of
   FD weakens with an increase in VFI. In addition, VFI is positively
   associated with environmental pollution, with GTI playing a mediating
   role in this association. This study aims to achieve green economic
   development by optimizing inter-governmental fiscal relationship.},
