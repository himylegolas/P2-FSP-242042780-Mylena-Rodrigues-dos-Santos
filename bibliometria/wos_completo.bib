@article{ WOS:001567286300001,
Author = {Liu, Yanmei and Wu, Rui and Huang, Jingxin and Li, Jingyun},
Title = {Research on the optimization of the intergovernmental sharing mechanism
   of public services under the new pattern of ``dual circulation{''}},
Journal = {INTERNATIONAL REVIEW OF ECONOMICS \& FINANCE},
Year = {2025},
Volume = {103},
Month = {OCT},
Abstract = {This study employs the System Generalized Method of Moments (GMM) to
   analyze and test the impact of the central government's moderate
   collection of public service powers on local economic development. The
   results demonstrate that a 1 \% increase in the degree of
   recentralization leads to a 1.2852 \% improvement in local economic
   operational efficiency, confirming the necessity and significance of the
   central government's recentralization of public service
   responsibilities. Furthermore, the level of local economic development
   plays a positive moderating role in this relationship-higher levels of
   local economic development amplify the positive effect of
   recentralization on local economic operational efficiency. This study
   enriches the application of fiscal decentralization theory in the
   Chinese context and provides practical policy recommendations for
   achieving high-quality development and mitigating public risks under the
   ``dual circulation{''} new development paradigm, holding significant
   theoretical and practical implications.},
