@article{ WOS:000235013800004,
Author = {Karnik, A and Lalvani, M},
Title = {Urban local governments and the flypaper effect: Evidence from
   Maharashtra, India},
Journal = {PUBLIUS-THE JOURNAL OF FEDERALISM},
Year = {2005},
Volume = {35},
Number = {2},
Pages = {273-295},
Month = {SPR},
Abstract = {This article examines decentralization in the state of Maharashtra in
   India, especially with respect to the functioning of its urban local
   governments. Using panel data, the article specifically investigates the
   flypaper effect of grants from the state government to urban local
   bodies. It also addresses the asymmetry hypothesis, which states that
   subnational governments respond differently to a reduction in grants
   than to an increase. Our results demonstrate the Presence of the
   flypaper effect, but evidence regarding the asymmetric response to a
   reduction in grants is ambiguous.},
