@article{ WOS:001597646200001,
Author = {Li, Yanzhang and Li, Zhao and Lyu, Bingyang},
Title = {Follow the Money: Fiscal Incentives and Tax-Base-Oriented Public
   Expenditure in Chinese Counties},
Journal = {PUBLIC PERFORMANCE \& MANAGEMENT REVIEW},
Year = {2026},
Volume = {49},
Number = {3},
Pages = {728-754},
Month = {MAY 4},
Abstract = {This study explores how fiscal incentives influence county-level
   spending priorities in China. Using a county-level panel dataset from
   2000 to 2006, we find that higher retention rates of tax revenue from
   local production activities incentivize counties to allocate
   expenditures toward capital construction that enhances the productive
   tax base. Political motivations and transfer payments amplify this
   effect. While this fosters local investment and output expansion, it
   simultaneously crowds out education and administrative expenditure that
   do not yield immediate fiscal returns. Our findings elucidate the
   underlying mechanism of fiscal incentives and provide valuable insights
   into designing incentive structures to achieve targeted policy
   objectives.},
