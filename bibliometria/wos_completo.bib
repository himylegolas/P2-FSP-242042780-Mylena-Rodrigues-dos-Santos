@article{ WOS:000075073100014,
Author = {Cetrangolo, O and Jimenez, JP and Vega, D},
Title = {Some thoughts on fiscal federalism in Argentina - Notes for designing a
   new system for tax sharing},
Journal = {DESARROLLO ECONOMICO-REVISTA DE CIENCIAS SOCIALES},
Year = {1998},
Volume = {38},
Number = {SI},
Pages = {293-327},
Note = {2nd Conference on Economics, BUENOS AIRES, ARGENTINA, JUN 23-24, 1997},
Abstract = {The growing conflict of the financial relations between federal and
   states governments has motivated an intense debate during the last
   years. In this con text, th a last Constitution reform explicitly
   establishes that a new tax sharing law has to be passed, giving an
   additional impulse to the previous debate. The objective of this paper
   is to arrange a group of reflections and recommendations that should be
   present when the new system of distribution will be discussed.
   Considering that public provision of health, education and housing are
   in the hands of state and municipal governments, any intent to improve
   the access of the population to these goods assigned to moderate
   inequality needs the redefinition of financing. In this sense, we
   believe that the modification of the original lines of the discussion is
   necessary. We think, as well, that the defense of some specific ratio of
   distribution for a state or the ``first priority{''} definition that the
   Federal government has to surrender resources to the states are not
   relevant. Otherwise, we intend to discuss the theoretical basis and the
   historical and institutional arguments of different ways of
   distribution, allowing a more healthy and clear relationship between the
   federal and state governments.},
