@article{ WOS:001563698400001,
Author = {Wu, Mengdi and Xu, Jili and Liu, Xiangjie},
Title = {Contextualizing state-market relations in urban financialization: the
   growth and uneven geography of urban investment bonds in Chinese cities},
Journal = {EURASIAN GEOGRAPHY AND ECONOMICS},
Year = {2026},
Volume = {67},
Number = {7},
Pages = {783-805},
Month = {OCT 3},
Abstract = {The theorization of urban development and transformation has long
   adhered to a simplistic dichotomy that portrays the state and the market
   as diametrically opposed forces. The emergence of urban financialization
   in China has recently generated new discussions on state-market
   relations beyond the binary narrative. This study examines the growth
   and uneven geography of urban investment bonds (UIBs) in China to deepen
   our understanding of state-market relations in a transitional economy.
   An empirical analysis of 335 Chinese cities and regions at and above the
   prefectural level shows that the development of UIBs between 2016 and
   2021 is significantly affected by intra-state bailout relations. Results
   show a positive relationship between the development of UIBs and
   previous bailouts through local government bonds and a U-shaped
   relationship between the development of UIBs and the degree of
   special-purpose transfers, which are typical inter-regional budget
   transfers that may generate bailout expectations. The findings challenge
   the prevailing binary narrative of state retreat and market advancement
   by suggesting that actual bailouts and bailout expectations in
   intra-state bailout relations have positive effects on China's urban
   financialization. In addition, the spatial variation in UIB development
   is shaped by different local conditions of economic development, land
   finance, and urban hierarchy. Findings of this study underscore the
   importance of contextual embeddedness for understanding the complexity
   and diversity of state-market interplay.},
