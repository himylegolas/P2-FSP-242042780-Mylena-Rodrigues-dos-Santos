@article{ WOS:001866224900001,
Author = {Li, Qing and Yan, Mengjie and Shi, Yu},
Title = {Fiscal Competition, Intergovernmental Transfer, and Local Debt
   Management},
Journal = {PUBLIC PERFORMANCE \& MANAGEMENT REVIEW},
Year = {2026},
Month = {2026 SEP 2},
Abstract = {This study examines how tax and expenditure competition, two distinct
   yet complementary mechanisms of horizontal fiscal governance, affect
   local debt management in China's local government bond market, using a
   two-stage least squares (2SLS) approach. It further investigates the
   moderating role of intergovernmental transfers intended to promote
   fiscal stabilization and equalization. Drawing on panel data from 272
   prefecture-level cities between 2010 and 2018, the results indicate that
   intensified tax and expenditure competition significantly increases
   local government debt, while intergovernmental transfers reduce direct
   borrowing needs through a substitution effect but exacerbate debt
   accumulation under fiscal competitive pressure by weakening local fiscal
   discipline. The study contributes to the public management and
   performance literature by highlighting how fiscal governance can distort
   local managerial incentives and undermine local debt management.},
