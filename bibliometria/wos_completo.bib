@article{ WOS:001622194700001,
Author = {Zhu, Ying and Huang, Ke},
Title = {Fiscal pressure, tax enforcement and stock price crash risk: empirical
   evidence from China},
Journal = {APPLIED ECONOMICS},
Year = {2025},
Month = {2025 NOV 24},
Abstract = {Leveraging China's most comprehensive fiscal data of 284 cities and
   financial data of 3476 listed firms during 2003-2020, we provide strong
   evidence that local fiscal pressure significantly reduces firm-specific
   stock price crash risk within their jurisdiction. Identification
   strategies including DID with a quasi-natural experiment and 2SLS with a
   Bartik instrument consistently validate causal inference. Mediating
   analysis demonstrates that intensified tax enforcement under fiscal
   pressure mitigates managerial bad news hoarding. Cross-sectional tests
   reveal attenuated effects in high non-tax/land-revenue cities, non-SOEs,
   and high government trust firms. Our findings indicate how fiscal
   incentives reconfigure governance-disclosure dynamics, providing
   policymakers with actionable levers to calibrate fiscal decentralization
   systems while enhancing corporate monitoring mechanisms.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
