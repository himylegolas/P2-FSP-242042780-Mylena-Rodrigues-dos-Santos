@article{ WOS:000680868800025,
Author = {Yuksel, Cihan},
Title = {The Flypaper Effect: ``Reality{''} or ``Myth{''}? Evidence from Turkey},
Journal = {SOSYOEKONOMI},
Year = {2021},
Volume = {29},
Number = {49},
Pages = {483-500},
Month = {JUL},
Abstract = {Several empirical observations in the local government economics
   literature point out that the effect of an increase in intergovernmental
   transfers on local public expenditures is more than that of increased
   personal income. This situation is called the ``flypaper effect.{''}
   This study aims to reveal the relevant literature and to test the
   flypaper effect for Turkey. In this context, using panel data
   techniques, the flypaper effect is evidenced at the provincial level in
   Turkey from 2008-2017. At the same time, our findings indicate that
   grants have a stimulatory effect in Turkey.},
