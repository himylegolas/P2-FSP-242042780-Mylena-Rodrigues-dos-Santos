@article{ WOS:001545742500008,
Author = {Canyas, Oytun and Tosun, Mustafa Umur},
Title = {The Evaluation of the Complexity Index of the Tax System in Turkiye: An
   Analysis Based on the Example of Local Government Revenues},
Journal = {MALIYE DERGISI},
Year = {2025},
Number = {188},
Pages = {189-214},
Month = {JAN-JUN},
Abstract = {The aim of this study is to develop the Herfindahl Index (HE), which is
   used as an indicator offiscal illusion in the literature, for the
   Turkish Tax System. In line with the aforementioned purpose, the
   regulations that cause the complexity of the tax system have been tried
   to be analyzed from a legal and financial perspective. An attempt was
   made to develop HE by using the data on taxes between 2007-2023
   published by the General Directorate of Accounting of the Ministry of
   Treasury and Finance. In the study, the development of HE was examined
   when local government revenues were included in the central government
   budget revenues. Thus, a more realistic calculation of HE, the indicator
   of tax complexity, was attempted in terms of the Turkish Tax System. It
   was concluded that HE, which takes a value between zero and one,
   approaches zero more when local government revenues are included, and
   the complexity of the Turkish Tax System increases.},
