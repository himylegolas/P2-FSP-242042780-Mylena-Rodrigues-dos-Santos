   Correa Bedoya, Nilson, Univ Nacl Autonoma Mexico, Posgrad Geog, Ciudad De Mexico, Mexico.
   Ruiz Rivera, Naxhelli, Univ Nacl Autonoma Mexico, Inst Geog, Ciudad De Mexico, Mexico.},
ISSN = {0718-8838},
EISSN = {0719-1790},
Keywords = {Autonomy; decentralization; Disaster risk reduction; Structural Equation
   Modeling; Intergovernmental transfers},
Research-Areas = {Public Administration},
Web-of-Science-Categories  = {Public Administration},
