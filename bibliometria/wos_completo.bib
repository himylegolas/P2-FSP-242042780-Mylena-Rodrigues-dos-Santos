Number = {3},
Pages = {927-949},
Month = {AUG},
Abstract = {This article studies the party alignment bias in Poland. Relying on
   quasi-experimental regression discontinuity design and 2006-2019 data
   for over 2,400 municipalities, we aim to establish whether the impact of
   political alignment on the distribution of grants from the central to
   the local governments has increased under the rules of populist,
   authoritarian government. We report robust evidence that provides an
   affirmative answer to this question.},
