@article{ WOS:000408729600002,
Author = {Lei, Jinghua and Chen, Yanbin and Jia, Junxue and Liu, Kai},
Title = {Public Expenditure Interactions of Chinese Local Governments: A
   Simultaneous Equations Network Approach},
Journal = {EMERGING MARKETS FINANCE AND TRADE},
Year = {2017},
Volume = {53},
Number = {9},
Pages = {1943-1960},
Abstract = {Fiscal competition, mimicking, and interactions among local governments
   exist as a complex network. To better model and estimate public
   expenditure interactions of Chinese local governments, we adopt a
   simultaneous equations network approach in which spatial dependence of
   multiple components of local governments' spending and also the internal
   competition among different components of public expenditure within the
   same city are considered. Using Chinese county-level fiscal data, we
   find that the endogenous peer effect for capital construction
   expenditure is positive among Chinese local governments, capital
   construction expenditure and administrative expenditure are complements
   rather than substitutes, there is no fiscal mimicking of social welfare
   expenditure, and there is a strong crowd-out effect of administrative
   expenditure on social welfare spending.},
