@article{ WOS:000878034700001,
Author = {Harada, Masataka and Matsubayashi, Tetsuya},
Title = {Intergovernmental transfers as magnets for low-income people},
Journal = {APPLIED ECONOMICS LETTERS},
Year = {2024},
Volume = {31},
Number = {6},
Pages = {513-517},
Month = {MAR 29},
Abstract = {We demonstrate that intergovernmental transfers affect migration
   decisions. If local governments with large distributive allocations
   offer greater government employment, public works projects, and
   assistance to (small) businesses, they attract low-skilled or unemployed
   residents to move or stay in. We find that more allocations increase not
   only the share of low-income residents but also the economic disparity
   in the city. We exploit the major electoral reform in Japan as an
   instrumental variable.},
