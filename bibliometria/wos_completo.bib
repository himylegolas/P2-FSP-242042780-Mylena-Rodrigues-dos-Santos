@article{ WOS:000651152900003,
Author = {Aritenang, Adiwan F.},
Title = {The contribution of foreign investment and industrial concentration to
   firm competitiveness in Jakarta Megacity},
Journal = {CITIES},
Year = {2021},
Volume = {113},
Month = {JUN},
Abstract = {This paper investigates the manufacturing firm competitiveness in the
   megacity. Presently, studies on firms in the megacity recognizes the
   importance of firms as drivers of megacity by examines industrial types,
   spatial distributions, political and governance. The paper fills the
   research gap by looking at firm competitiveness in the Jakarta
   Metropolitan Area (JMA) using econometrics model in three levels; the
   firm, industrial sector and spatial administration. The result shows
   that firm decision and industry sectoral-based policies have higher
   effect, implying that local government policies are indifferent to
   generate firm competitiveness in the megacity. The study also highlights
   the importance of foreign investment and concentration of firms with
   foreign investments to enhance firm competitiveness. This paper
   contributes to the economic geography debate and policy by highlighting
   importance investment zones to attract concentration of global firms and
   necessity for coordination and synchronization between municipalities
   and with international stakeholders at the megacity level.},
