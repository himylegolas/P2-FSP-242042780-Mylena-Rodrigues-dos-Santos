@article{ WOS:000346944100024,
Author = {Sanoh, Aly},
Title = {Rainfall Shocks, Local Revenues, and Intergovernmental Transfer in Mali},
Journal = {WORLD DEVELOPMENT},
Year = {2015},
Volume = {66},
Pages = {359-370},
Month = {FEB},
Abstract = {This paper explores the implications of rainfall shocks for municipal
   tax revenues and intergovernmental transfers in Mali. I found that
   exogenous phenomena such as weather, not under the control of local
   actors, could affect the way de facto decentralization plays out by
   influencing the fiscal capacity of local governments. In a panel data of
   692 municipalities from 2000 to 2008, I found that rainfall shocks,
   through the fluctuations they induce in agricultural incomes, affect
   revenue collection of local governments, and in turn drive further
   revenues local governments receive through transfer by the central
   government. (C) 2014 Elsevier Ltd. All rights reserved.},
Publisher = {PERGAMON-ELSEVIER SCIENCE LTD},
