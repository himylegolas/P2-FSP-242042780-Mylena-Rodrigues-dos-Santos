@article{ WOS:000209380100006,
Author = {Ayee, Joseph R. A.},
Title = {The Political Economy of the Creation of Districts in Ghana},
Journal = {JOURNAL OF ASIAN AND AFRICAN STUDIES},
Year = {2013},
Volume = {48},
Number = {5},
Pages = {623-645},
Month = {OCT},
Abstract = {There has been a flurry of publications examining Ghana's
   decentralization programme since 1988 to date. None has, however,
   specifically focused on the creation of districts; that is, the
   political and geographical division of the state into smaller
   jurisdictions - arguably regarded as one of the key processes of
   decentralization. In other words, the numerous studies do not fully
   explain the politics of the creation of districts, which has not only
   been a recurring phenomenon but also a contentious and sensitive one.
   This paper aims at filling this lacuna by identifying the actors and
   discussing their interests, benefits and the tensions arising from the
   creation of new districts in Ghana. The lessons learnt are also
   highlighted.},
