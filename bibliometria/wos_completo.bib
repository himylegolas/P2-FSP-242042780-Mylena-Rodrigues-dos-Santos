@article{ WOS:000470897500006,
Author = {Figueiredo, Marcelo},
Title = {TRANSFORMATIONS IN THE BRAZILIAN FEDERAL STATE},
Journal = {REVISTA GENERAL DE DERECHO PUBLICO COMPARADO},
Year = {2018},
Number = {23},
Month = {JUN},
Abstract = {In the Constitution of 1891, the federative regime was structured
   according to the North American model. The division of competencies
   established by the 1988 Constitution is structured as a complex system
   in which private competences are combined with concurrent, cumulative
   and non-cumulative competences. Each level of government has the right
   to institute the taxes and that belongs to its exclusive jurisdiction.
   Constitutional transfers, in the Brazilian case, are essentially
   redistributive and do not take into account the efficiency criteria, the
   collection capacity or the fiscal effort performed by the federated
   units, either by states or municipalities. Brazil has a model of
   symmetric federalism in an asymmetric federation.
   Few exclusive constitutional powers are given to the states and
   municipalities, on the other hand, states and municipalities have
   administrative autonomy and responsibilities for the implementation of
   policies approved in the federal sphere.},
Publisher = {IUSTEL},
Address = {C PRINCESA NO 29, 2A DCHA, MADRID, 28008, SPAIN},
