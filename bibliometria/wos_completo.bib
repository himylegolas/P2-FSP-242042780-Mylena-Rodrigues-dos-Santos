   and Spacek, David},
Title = {Does the Financial Self-sufficiency of Municipalities Affect Efficiency
   of the Museums which they Founded? (A Case Study from the Czech
   Republic)},
Journal = {LEX LOCALIS-JOURNAL OF LOCAL SELF-GOVERNMENT},
