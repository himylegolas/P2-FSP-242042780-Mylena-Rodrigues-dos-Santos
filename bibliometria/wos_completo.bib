@article{ WOS:000424783900005,
Author = {Guadalupe Naranjo-Cantabrana, Maria},
Title = {FISCAL FEDERALISM IN UNITED MEXICAN STATES},
Journal = {REVISTA RA XIMHAI},
Year = {2017},
