@article{ WOS:001542395200004,
Author = {Torrezan, Raphael Guilherme Araujo and de Paiva, Claudio Cesar},
Title = {Fiscal decentralization and budgetary governance: An analysis of
   municipalities in Sao Paulo State},
Journal = {CADERNOS GESTAO PUBLICA E CIDADANIA},
Year = {2025},
Volume = {30},
Abstract = {This article analyzes the budgetary governance of municipalities in S \&
   atilde;o Paulo State based on Governanga Orgament \& aacute;ria da
   Organizag \& atilde;o para a Cooperag \& atilde;o e Desenvolvimento Econ
   \& ocirc;mico (OCDE, Organization for Economic Co-operation and
   Development) principles, using data from the S \& atilde;o Paulo State
   Court of Accounts. The budgetary principles were organized into four
   governance dimensions: fiscal, programmatic, participatory, and
   accountability, evaluated across 644 municipalities. The findings
   indicate formal compliance with fiscal regulations and the
   institutionalization of internal control mechanisms. However, they also
   expose persistent structural deficiencies in strategic planning
   capabilities, transparency arrangements, and the systematic evaluation
   of public policies. The study highlights the importance of strengthening
   the integration of budgetary planning, execution, and monitoring,
   expanding participatory mechanisms, and adopting efficiency criteria in
   resource allocation to enhance the quality of budgetary governance at
   the local level.},
Publisher = {FUNDACAO GETULIO VARGAS ESCOLA ADM EMPRESAS SAO PAULO},
