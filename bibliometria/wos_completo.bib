@article{ WOS:000287038000004,
Author = {Hammond, George W. and Tosun, Mehmet S.},
Title = {THE IMPACT OF LOCAL DECENTRALIZATION ON ECONOMIC GROWTH: EVIDENCE FROM
   US COUNTIES},
Journal = {JOURNAL OF REGIONAL SCIENCE},
Year = {2011},
Volume = {51},
Number = {1},
Pages = {47-64},
Month = {FEB},
Abstract = {We analyze the impact of fiscal decentralization on U. S. county
   population, employment, and real income growth. Our findings suggest
   that government organization matters for local economic growth, but that
   the impacts vary by government unit and by economic indicator. We find
   that single-purpose governments per square mile have a positive impact
   on metropolitan population and employment growth, but no significant
   impact on nonmetropolitan counties. In contrast, the fragmentation of
   general-purpose governments per capita has a negative impact on
   employment and population growth in nonmetropolitan counties. Our
   results suggest that local government decentralization matters
   differently for metropolitan and nonmetropolitan counties.},
