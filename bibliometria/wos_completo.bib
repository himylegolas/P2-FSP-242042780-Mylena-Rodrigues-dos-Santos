@article{ WOS:000256609700015,
Author = {Bai, Chong-En and Tao, Zhigang and Tong, Yueting Sarah},
Title = {Bureaucratic integration and regional specialization in China},
Journal = {CHINA ECONOMIC REVIEW},
Year = {2008},
Volume = {19},
Number = {2},
Pages = {308-319},
Month = {JUN},
Abstract = {Fiscal decentralization introduced as part of China's economic reform
   since 1979 has unleashed strong incentives for China's local governments
   to pursue economic development, but the same incentives have also led to
   local protectionist policies inhibiting the process of regional
   specialization. This paper focuses on the constraints or freedom with
   which local governments can implement their protectionist policies.
   Using a panel data of 29 China's regions over the time period of
   1985-1997, we find that China's political system of bureaucratic
   integration (specifically, concurrent appointment of local government
   officials in the central government) imposes constraints on the local
   governments from practicing protectionism. We also find that the
   effectiveness of local protectionist policies is limited by market
   competition, specifically, competition from foreign-invested firms
   operating in China and foreign imports. Our results on the role of local
   protectionism remain robust to controls for the regional variations in
   the size of the economy and the stage of economic development. (c) 2006
   Elsevier Inc. All rights reserved.},
Publisher = {ELSEVIER SCIENCE INC},
Address = {360 PARK AVE SOUTH, NEW YORK, NY 10010-1710 USA},
Type = {Article},
Language = {English},
Affiliation = {Tao, ZG (Corresponding Author), Tsinghua Univ, Sch Econ \& Management, Beijing 100084, Peoples R China.
   Bai, Chong-En, Tsinghua Univ, Sch Econ \& Management, Beijing 100084, Peoples R China.
   Tao, Zhigang, Univ Hong Kong, Sch Business, Hong Kong, Hong Kong, Peoples R China.
   Tong, Yueting Sarah, Natl Univ Singapore, Dept Econ, Singapore 117570, Singapore.
   Tong, Yueting Sarah, Natl Univ Singapore, E Asian Inst, Singapore 117570, Singapore.},
DOI = {10.1016/j.chieco.2006.11.005},
ISSN = {1043-951X},
