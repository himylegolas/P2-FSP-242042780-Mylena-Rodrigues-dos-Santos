@article{ WOS:000313312200015,
Author = {Boadway, Robin and Tremblay, Jean-Francois},
Title = {Reassessment of the Tiebout model},
Journal = {JOURNAL OF PUBLIC ECONOMICS},
Year = {2012},
Volume = {96},
Number = {11-12, SI},
Pages = {1063-1078},
Month = {DEC},
Abstract = {The Tiebout model has been the reference point for the classical
   approach to fiscal federalism. Its emphasis on mobility, benefit
   taxation, and the advantages of fiscal competition have informed fiscal
   federalism since the seminal contributions of Musgrave and Oates. This
   paper reviews the influence that the Tiebout model has had on fiscal
   federalism, and argues that while its insights remain relevant for local
   government, it is far from compelling as a positive description of, or a
   normative prescription for, fiscal federalism at the state level. Some
   aspects of alternative approaches are presented, which lead to different
   perspectives than Tiebout-inspired ones. (C) 2011 Elsevier B.V. All
   rights reserved.},
Publisher = {ELSEVIER SCIENCE SA},
