@article{ WOS:000418935900007,
Author = {Boadway, Robin and Cuff, Katherine},
Title = {The impressive contribution of Canadian economists to fiscal federalism
   theory and policy},
Journal = {CANADIAN JOURNAL OF ECONOMICS-REVUE CANADIENNE D ECONOMIQUE},
Year = {2017},
Volume = {50},
Number = {5},
Pages = {1348-1380},
Month = {DEC},
Abstract = {The study of fiscal federalism has been central to the research of
   Canadian economists since the Rowell-Sirois Report. To mark the 50th
   anniversary of the founding of the Canadian Economics Association, it is
   fitting to take stock of their contributions. We focus on the period
   since 1982 and emphasize the main scholarly publications of an inclusive
   array of Canadian economists and economists in Canadian universities.
   Our attention is devoted to applications in the context of federal and
   provincial governments, setting aside related issues in municipal
   government finance. We briefly discuss instances where the fiscal
   federalism literature has informed policy debates including through
   policy research institutes, government commissions and international
   organizations.},
