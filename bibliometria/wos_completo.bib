@article{ WOS:001790907100001,
Author = {Cheng, Guangyu and Chen, Yang},
Title = {Seeking for revenue or promotion? Incentives of Chinese governments in
   urban land conveyance},
Journal = {JOURNAL OF ASIAN PUBLIC POLICY},
Year = {2026},
Month = {2026 JUN 12},
Abstract = {China's local governments are keen on utilizing land conveyances to
   mobilize fiscal resources. Two theories can explain their incentives in
   operating land conveyances: fiscal federalism and promotion tournament.
   The former highlights the economic benefits, whereas the latter centres
   on political promotion through achieving economic growth. We aim to
   investigate the applicability of these two theories by looking into land
   transfers and socioeconomic performances of Yangtze River Delta during
   2008 and 2021. Empirical results show that (1) local governments use
   industrial land transfers to stimulate nonindustrial transactions,
   generating short-term land incomes; (2) land conveyances on the market
   contribute little to local budgetary revenue growth; (3) local
   governments invest land conveyance incomes in urban infrastructure to
   stimulate economic growth, but these effects fade quickly. These
   findings suggest that revenue generation is not the ultimate objective
   of local governments in land conveyance. Instead, local officials use
   land-based financing to enhance their promotion prospects in regional
   economic competition. Research findings support the inference of
   promotion tournament theory. This study sheds light on decentralization
   reform in transition economies and local government financing in unitary
   regimes.},
