@article{ WOS:001542395200001,
Author = {Dantas Jr, Amarando Francisco and Diniz, Josedilton Alves},
Title = {Federative arrangements and fiscal federalism: a proposal for municipal
   merger in Brazil},
Journal = {CADERNOS GESTAO PUBLICA E CIDADANIA},
Year = {2025},
Volume = {30},
Abstract = {The Brazilian three-tier federative model has presented two that have
   been aggravated since the 1988 Federal Constitution: low fiscal effort
   in revenue collection and horizontal imbalances at the municipal level.
   International experience shows a relatively common approach to
   addressing problems. However, it is a solution rarely discussed in
   federative rearrangement through municipal amalgamations that is, the
   systematic merger of municipalities. This proposes municipal
   amalgamations that simultaneously increase operational self-sufficiency
   and reduce horizontal imbalances. study analyzes the effects of fiscal
   effort on the self-sufficiency municipalities when a merger model is
   applied to maximize average municipal fiscal effort. The results point
   to a new scenario: 70\% reduction in the total number of municipalities,
   increase in collection effort, and a 36\% increase in operational
   self-sufficiency.},
Publisher = {FUNDACAO GETULIO VARGAS ESCOLA ADM EMPRESAS SAO PAULO},
