@article{ WOS:000504895700014,
Author = {Chan, Jeff},
Title = {The Effect of Immigration on Local Public Finances},
Journal = {ECONOMICS BULLETIN},
Year = {2019},
Volume = {39},
Number = {4},
Pages = {2423-2428},
Abstract = {I investigate the relationship between immigration and local public
   finances, exploiting variation in immigration inflows across local
   labour markets and data on local government revenues and expenditures. I
   find that increases in immigration did not result in any change to local
   government revenues. This is not explained by offsetting decreases in
   revenues from local sourcs and increases from state-level
   intergovernmental transfers. Finally, I demonstrate that the lack of
   impact on revenues similarly implies that immigration does not have an
   effect on local public expenditures. The findings suggest that
   immigration does not act as a drain on local public finances.},
