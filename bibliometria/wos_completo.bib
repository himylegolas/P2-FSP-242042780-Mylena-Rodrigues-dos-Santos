@article{ WOS:000788080400005,
Author = {Lewis, Blane D.},
Title = {The impact of democratic elections on taxation: Quasi-experimental
   evidence from subnational Indonesia},
Journal = {ECONOMICS LETTERS},
Year = {2022},
Volume = {211},
Month = {FEB},
Abstract = {I examine the impact of direct mayoral elections on taxation in
   Indonesia. I find that districts led by directly elected mayors tax less
   than districts with council appointed executives. Uniquely in the
   literature, I also determine that districts with directly elected mayors
   and, by implication, districts with council appointed heads both tax
   more than their counterparts with central government appointed
   executives. (C) 2022 Elsevier B.V. All rights reserved.},
