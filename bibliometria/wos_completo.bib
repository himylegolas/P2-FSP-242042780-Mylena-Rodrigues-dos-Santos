@article{ WOS:001628108100006,
Author = {Wang, Yizi and Zhang, Jiaqi},
Title = {The reference point effect in local government debt expansion: empirical
   evidence from China},
Journal = {FINANCE RESEARCH LETTERS},
Year = {2025},
Volume = {86},
Number = {G},
Month = {DEC},
Abstract = {This study investigates the micro-level behavioral logic driving local
   government debt expansion in China within the institutional framework of
   fiscal decentralization and intergovernmental competition. Grounded in
   the reference point theory, we employ panel data from 332
   prefecture-level cities between 2017 and 2023 to systematically examine
   the existence and mechanisms of the reference point effect in local
   government debt expansion. The results reveal four key findings. First,
   a significant reference point effect based on GDP ranking is identified:
   local governments adjust their borrowing decisions in response to the
   debt levels of higher-ranked or adjacent cities. Second, officials'
   promotion incentives amplify the reference point effect in
   contemporaneous debt expansion. Third, the reference point effect
   persists across both general and special bonds and is evident
   irrespective of cities' levels of financial development. Fourth, the
   persistence of similar reference point effects under alternative fiscal
   and financial benchmarks suggests multidimensional competitive dynamics
   in local government debt expansion. These findings provide new insights
   for optimizing local debt governance frameworks and mitigating fiscal
   risks arising from competitive borrowing among local governments.},
