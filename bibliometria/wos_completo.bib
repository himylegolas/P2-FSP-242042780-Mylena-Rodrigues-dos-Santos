@article{ WOS:000420284800005,
Author = {Yas, Hakan and Akdugan, Umut},
Title = {Analyzing the Financial Transfers Delivered to Municipalities in Turkey
   within the Scope of Flypaper Effect},
Journal = {MALIYE DERGISI},
Year = {2015},
Number = {168},
Pages = {49-68},
Month = {JAN-JUN},
Abstract = {In this paper, it is sought out to what extent the financial transfers
   from central government to municipalities and municipal revenues have an
   effect on the expenditures of municipalities in Turkey. In order to
   reach the aim, the overall position of the own-revenues, the financial
   transfers and the expenditures of the municipalities initially
   presented. Subsequent to this presentation, multiple regression analysis
   is carried out by using the related data. As a result of the analysis,
   the existence of the postulate known as flypaper effect in the
   literature is observed. The reason of this postulate is tried to be
   explained by the problem of financial autonomy. The other finding in
   this paper is that the increase in financial transfers indirectly leads
   to increase in the municipal borrowing amounts.},
