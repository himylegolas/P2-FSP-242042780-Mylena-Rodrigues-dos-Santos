@article{ WOS:000620399800016,
Author = {Peng, Wei and Lee, Chi-Chuan and Xiong, Ke},
Title = {What Determines the Subsidy Decision Bias of Local Governments? An
   Enterprise Heterogeneity Perspective},
Journal = {EMERGING MARKETS FINANCE AND TRADE},
Year = {2021},
Volume = {57},
Number = {4},
Pages = {1215-1231},
Month = {MAR 16},
Abstract = {This paper evaluates whether enterprise heterogeneity affects the
   subsidy behavior of local governments for Chinese listed companies over
   the period 2007-2017. After using the logit and the Tobit regression
   analyses, the result reveals that enterprise heterogeneity significantly
   influences the fiscal subsidy selection strategy and policy bias. Local
   governments are more likely to subsidize high-tech enterprises,
   state-owned enterprises, and exporting enterprises. The profitability of
   an enterprise is negatively related subsidies, which confirms the
   helping-hand role played by local governments. The robustness of our
   findings is explored in a variety of extensions including quantile
   regression and investigation of regional heterogeneities.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
