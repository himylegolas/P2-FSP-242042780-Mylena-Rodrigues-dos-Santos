@article{ WOS:000261592300004,
Author = {Dahlberg, Matz and Moerk, Eva and Rattso, Jorn and Agren, Hanna},
Title = {Using a discontinuous grant rule to identify the effect of grants on
   local taxes and spending},
Journal = {JOURNAL OF PUBLIC ECONOMICS},
Year = {2008},
Volume = {92},
Number = {12},
Pages = {2320-2335},
Month = {DEC},
Note = {Conference on New Directions in Fiscal Freedom, Lexington, KY, SEP, 2006},
Organization = {Univ Kentucky, Inst Federalism \& Intergovt Relat; CESifo},
Abstract = {When investigating the effects of federal grants on the behavior of
   lower-level governments, it is hard to defend the handling of grants as
   an exogenous factor. Federal governments often set grants based on
   characteristics and performance of decentralized governments. In this
   paper we make use of a discontinuity in the Swedish grant system in
   order to estimate the causal effects of general intergovernmental grants
   on local spending and local tax rates. The formula for the distribution
   of funds is used as an exclusion restriction in an IV-estimation. We
   find evidence of crowding-in, where federal grants are shifted to more
   local spending, but not to reduced local tax rates. (C) 2007 Elsevier
   B.V. All rights reserved.},
