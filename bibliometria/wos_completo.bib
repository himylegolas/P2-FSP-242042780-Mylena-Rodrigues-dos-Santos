@article{ WOS:001877291900001,
Author = {Azevedo, Beatriz Costa and Veiga, Linda Goncalves and Cerejeira, Joao},
Title = {The effects of decentralisation on educational outcomes: insights from
   the 2009 and 2015 Portuguese reforms},
Journal = {EDUCATION ECONOMICS},
Year = {2026},
Month = {2026 SEP 11},
Abstract = {This paper analyses the effects of two education decentralisation
   reforms in Portugal, based on execution contracts signed in 2009 and
   2015. Using difference-in-differences estimators robust to staggered
   treatment timing, we examine effects on access to public education,
   student outcomes, and financial transfers. The 2009 reform appears to
   have reduced repetition rates and increased public enrolment in later
   basic-education cycles; the 2015 reform shows no statistically
   significant effects, though the limited number of treated municipalities
   constrains the power to detect smaller effects. Financial transfers to
   participating municipalities increased, more clearly after 2009. These
   findings inform the policy debate on education decentralisation.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
