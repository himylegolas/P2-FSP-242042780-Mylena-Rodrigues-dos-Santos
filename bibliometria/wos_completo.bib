@article{ WOS:000514293600001,
Author = {Thanh, Su D. and Canh, Nguyen P.},
Title = {Local Governance: Impacts of Fiscal Decentralization on Government Size
   and Spending Composition in Vietnam{*}},
Journal = {ASIAN ECONOMIC JOURNAL},
Year = {2019},
Volume = {33},
Number = {4},
Pages = {311-340},
Month = {DEC},
Abstract = {The study provides an understanding of the impacts of fiscal
   decentralization and local governance on government size and spending
   composition. We use a balanced panel data set of 63 provinces of Vietnam
   over the 2006-2015 period. By estimating the spatial Durbin model, we
   find that local public spending and government size grow over time and
   have spatial spillovers. Fiscal decentralization significantly reduces
   public spending and government size, which supports the Leviathan
   hypothesis. More interestingly, combining local governance, the marginal
   spatial spillover effects of the fiscal decentralization on public
   spending and government size are intensified. Our findings imply that
   local governments should enhance interregional collaboration in fiscal
   management to limit duplicate public spending and promote regional
   sustainable development.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
