@article{ WOS:000464512500002,
Author = {Millsap, Adam A. and Hobbs, Bradley K. and Stansel, Dean},
Title = {Local Governments and Economic Freedom: A Test of the Leviathan
   Hypothesis},
Journal = {PUBLIC FINANCE REVIEW},
Year = {2019},
Volume = {47},
Number = {3},
Pages = {493-529},
Month = {MAY},
Abstract = {Brennan and Buchanan's Leviathan hypothesis states that ``potential for
   fiscal exploitation varies inversely with the number of competing
   governmental units{''} (p. 211) and that ``total government intrusion
   into the economy should be smaller, ceteris paribus, the greater the
   extent to which taxes and expenditures are decentralized {[}and]
   horizontal ellipsis the smaller the jurisdictions{''} (p. 185). Using
   data for US metropolitan statistical areas, we provide the first
   local-level test of that hypothesis (that we are aware of) that uses
   ``economic freedom{''} as the dependent variable, which provides a
   better measure of ``total government intrusion into the economy{''} than
   the less comprehensive measures (taxes or spending) used in the previous
   literature. We find mixed support for the Leviathan hypothesis. The
   number of competing jurisdictions is positively associated with economic
   freedom, driven largely by the labor market freedom component as opposed
   to the government spending and tax components (the very measures used in
   the previous literature).},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article},
Language = {English},
Affiliation = {Stansel, D (Corresponding Author), Southern Methodist Univ, Dallas, TX 75275 USA.
   Millsap, Adam A., Florida State Univ, L Charles Hilton Jr Ctr, Tallahassee, FL 32306 USA.
   Hobbs, Bradley K., Clemson Univ, Econ, Clemson, SC USA.
   Stansel, Dean, Southern Methodist Univ, Dallas, TX 75275 USA.},
DOI = {10.1177/1091142118817909},
ISSN = {1091-1421},
