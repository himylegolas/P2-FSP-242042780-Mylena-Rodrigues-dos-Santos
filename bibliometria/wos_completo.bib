@article{ WOS:001392831000001,
Author = {Xu, Jianhui and Ruan, Ning and Liu, Qingfang and Zhang, Xiantian and
   Song, Jinping and Xie, Jialiang},
Title = {Does fiscal decentralization reduce air pollution: Evidence from
   Qinghai-Tibet Plateau},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2025},
Volume = {486},
Month = {JAN 1},
Abstract = {Fiscal decentralization plays an important role in controlling and
   reducing air pollution; however, there is a dearth of literature on the
   dynamic change of spatial spillover effect of fiscal decentralization on
   air pollution at county level. Taking Qinghai-Tibet Plateau as empirical
   object, this study explored whether fiscal decentralization can reduce
   air pollution. Our research finds that fiscal decentralization exerts a
   significantly positive effect on air pollution. More importantly, fiscal
   decentralization in local counties is conducive to reduce air pollution
   in adjacent counties at the long-term and short-term levels. However,
   the long-term spillover effect is not significant. Therefore, central
   government should focus on optimizing the systems of fiscal
   decentralization as well as the performance appraisal, thus promoting
   the performance of local government functions, especially pollution
   reduction. In addition, the coordination mechanism of reducing air
   pollution in Qinghai-Tibet Plateau needs to be established in the long
   run, and thus avoiding the ``free-rider{''} behavior from governments in
   the adjacent regions.},
