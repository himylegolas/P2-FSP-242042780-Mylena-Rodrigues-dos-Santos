   Song, Ce, China Reinsurance Grp Corp, Financial Markets Dept, Beijing, Peoples R China.
   Zeng, Linshan, Fujian Polytech Normal Univ, Sch Qiaoxing Econ \& Management, Fuqing, Peoples R China.},
DOI = {10.1111/acfi.70171},
