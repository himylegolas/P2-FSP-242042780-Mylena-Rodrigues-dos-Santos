@article{ WOS:000358625900007,
Author = {Han, Li and Kung, James Kai-Sing},
Title = {Fiscal incentives and policy choices of local governments: Evidence from
   China},
Journal = {JOURNAL OF DEVELOPMENT ECONOMICS},
Year = {2015},
Volume = {116},
Pages = {89-104},
Month = {SEP},
Abstract = {This paper examines how fiscal incentives affect the policy choices of
   local governments in the context of China. Based on exogenous changes in
   the intergovernmental revenue-sharing scheme, we construct a simulated
   instrumental variable to resolve the endogeneity problem. We find
   evidence that local governments shifted their efforts from fostering
   industrial growth to ``urbanizing{''} China, i.e., to developing the
   real estate and construction sectors, when their retention rate of
   enterprise tax revenue was reduced. The increase from the new revenue
   source compensated for half of the losses in revenue that resulted from
   the reassignment of fiscal rights. The reassignment had also the effect
   of retarding the industrial growth of domestically-owned firms in
   particular. (C) 2015 Elsevier B.V. All rights reserved.},
