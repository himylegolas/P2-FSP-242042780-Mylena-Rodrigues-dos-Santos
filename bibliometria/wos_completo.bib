   Yamamoto, Wataru, Univ Tokyo, Grad Sch Econ, Doctoral Program, Bunkyo Ku, 7-3-1 Hongo, Tokyo 1130033, Japan.},
DOI = {10.1007/s10797-016-9413-4},
ISSN = {0927-5940},
EISSN = {1573-6970},
Keywords = {Fiscal interaction; Local government expenditure; Yardstick competition;
   Fiscal federalism; Japan},
Keywords-Plus = {SPATIAL WEIGHTS MATRIX; LOCAL-GOVERNMENTS; STRATEGIC INTERACTION;
