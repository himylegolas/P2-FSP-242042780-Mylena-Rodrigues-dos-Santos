@article{ WOS:001353999700001,
Author = {Zhang, Zhi and Li, Jiangyu and Ma, Dong},
Title = {Extreme climate, local fiscal decentralization, and corporate
   sustainability},
Journal = {APPLIED ECONOMICS LETTERS},
Year = {2026},
Volume = {33},
Number = {9},
Pages = {1361-1366},
Month = {MAY 21},
Abstract = {Extreme weather events pose a significant threat to the sustainability
   of Chinese enterprises. This study investigates their impact on
   corporate sustainability and the moderating effect of local fiscal
   decentralization. Using a fixed-effects model with A-share listed
   companies from 2007-2021, it finds that extreme weather negatively
   impacts corporate sustainability, but fiscal decentralization mitigates
   this effect, notably in central-eastern regions and non-state
   enterprises. Recommendations include increasing local fiscal autonomy,
   accelerating SOE reforms, and enhancing environmental governance to
   bolster local governments' climate resilience and foster overall
   economic and corporate sustainability.},
