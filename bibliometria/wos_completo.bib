@article{ WOS:000319297100003,
Author = {Hopland, Arnt O.},
Title = {Central government control and fiscal adjustment: Norwegian evidence},
Journal = {ECONOMICS OF GOVERNANCE},
Year = {2013},
Volume = {14},
Number = {2},
Pages = {185-203},
Month = {MAY},
Abstract = {Norwegian local governments that violate the balanced budget rule are
   placed in a register. The consequence of being in the register is that
   the budget and resolutions to raise new loans must be approved by the
   county governor, the central government's representative in the county.
   Local governments in the register are subject to stronger central
   government control and must tighten their budgetary policy in order to
   be removed from the register. The findings suggest that local
   governments in the register improve their operating surplus, mainly due
   to cost reductions.},
