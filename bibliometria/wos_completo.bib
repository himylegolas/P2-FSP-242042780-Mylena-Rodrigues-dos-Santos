@article{ WOS:000077728700005,
Author = {Qian, YY and Roland, G},
Title = {Federalism and the soft budget constraint},
Journal = {AMERICAN ECONOMIC REVIEW},
Year = {1998},
Volume = {88},
Number = {5},
Pages = {1143-1162},
Month = {DEC},
Abstract = {The government's incentives to bail out inefficient projects are
   determined by the trade-off between political benefits and economic
   costs, the latter depending on the decentralization of government. Two
   effects of federalism are derived: First, fiscal competition among local
   governments under factor mobility increases the opportunity costs of
   bailout and thus serves as a commitment device (the ``competition
   effect{''}). Second monetary centralization, together with fiscal
   decentralization, induces a conflict of interests and thus may harden
   budget constraints and reduce inflation (the ``checks and balance
   effect{''}). Our analysis is used to interpret China's recent experience
   of transition to a market economy. (JEL E62, E63, H7, L30, P3).},
