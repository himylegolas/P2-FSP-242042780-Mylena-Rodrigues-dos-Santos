@article{ WOS:001811940400001,
Author = {Liu, Peng and Shen, Jianfei},
Title = {Artificial intelligence technology and local government debt burden:
   Nonlinear evidence from China},
Journal = {INTERNATIONAL REVIEW OF FINANCIAL ANALYSIS},
Year = {2026},
Volume = {117},
Month = {SEP},
Abstract = {Local government debt (LGD) risk is a major challenge to financial
   stability and fiscal sustainability. Although artificial intelligence
   (AI) technology is widely recognized as a driver of economic growth, its
   relationship with LGD remains unclear. Using provincial panel from China
   (2012-2022), we document a nonlinear (inverted-U) relationship between
   AI technology and LGD burden: LGD tends to increase during the growth
   phase of AI and decline as it matures. The results remain robust across
   multiple sensitivity tests. Mechanism analysis indicates that industrial
   intelligent transformation is a key channel underlying this
   relationship. The nonlinear effect is more pronounced in provinces with
   advanced digital infrastructure and lower fiscal decentralization. These
   findings indicate that the fiscal effects of technological innovation
   are stage-dependent and identify the mechanisms and conditions through
   which technological gains are transmitted to LGD burden.},
