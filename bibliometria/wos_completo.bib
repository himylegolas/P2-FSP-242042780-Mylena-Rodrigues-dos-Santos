@article{ WOS:A1993KX89000004,
Author = {HY, RJ and BOLAND, C and HOPPER, R and SIMS, R},
Title = {MEASURING REVENUE CAPACITY AND EFFORT OF COUNTY GOVERNMENTS - A
   CASE-STUDY OF ARKANSAS},
Journal = {PUBLIC ADMINISTRATION REVIEW},
Year = {1993},
Volume = {53},
Number = {3},
Pages = {220-227},
Month = {MAY-JUN},
Abstract = {How can local governments further identify underutilized revenue
   sources? Authors Hy, Boland, Hopper, and Sims demonstrate a technique
   called `'revenue capacity/effort analysis'' in application to counties
   in Arkansas. The analysis examines property taxes and `'combined lesser
   discretionary revenues,'' which include a variety of fees and other
   charges. It indicates that Arkansas counties (and the state as a whole)
   generally underutilize tax capacity. A variety of factors limits greater
   effort to raise additional revenues. The authors discuss bow this model
   can be useful in shaping intergovernmental transfers.},
