@article{ WOS:000533435000001,
Author = {Liu Yongzheng and Tai Hang and Yang Chenping},
Title = {Fiscal incentives and local tax competition: Evidence from China},
Journal = {WORLD ECONOMY},
Year = {2020},
Volume = {43},
Number = {12, SI},
Pages = {3340-3356},
Month = {DEC},
Abstract = {This paper explores how fiscal incentives affect capital tax decisions
   by local governments in the Chinese context. We develop a model in which
   local governments, facing different fiscal incentives, compete for
   mobile capital over corporate taxes. The key prediction of the model,
   borne out in data from Chinese cities over the years 2004-13, is that an
   increase in the local corporate income tax-sharing ratio, proxying local
   fiscal incentives, makes city governments' horizontal tax reactions
   stronger. Our results contribute to the fiscal federalism literature by
   providing evidence in support of the argument that fiscal incentives
   faced by local governments significantly shape their policy choices.
   Additionally, we provide explicit evidence on local tax competition
   within provinces in China, which has long been regarded as one of the
   driving forces of China's rapid economic growth.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
