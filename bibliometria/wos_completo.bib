@article{ WOS:001072641200001,
Author = {Chen, Meng-Ting and Zhang, Jiakai},
Title = {Political hierarchy spillovers: Evidence from China},
Journal = {ECONOMIC INQUIRY},
Year = {2024},
Volume = {62},
Number = {1},
Pages = {329-348},
Month = {JAN},
Abstract = {This paper explores the impact of the political hierarchies of cities in
   China from different perspectives. First, we examine the economic
   disparities between prefectural cities and municipalities. Furthermore,
   this paper draws upon a quasi- experiment to analyze the impact of
   upgrading Chongqing to a municipality in 1997 using the synthetic
   control method. The city-upgrading policy significantly increased
   Chongqing's gross domestic product (GDP) in the following 4 years.
   Finally, we find that the policy increased GDP in treated cities within
   1200 km of Chongqing by about 10\%-13\% relative to the control cities.},
