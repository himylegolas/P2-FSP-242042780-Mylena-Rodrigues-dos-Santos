@article{ WOS:000265425800009,
Author = {Blomquist, Soren and Micheletto, Luca},
Title = {NONLINEAR INCOME TAXATION AND MATCHING GRANTS IN A FEDERATION WITH
   DECENTRALIZED IN-KIND TRANSFERS},
Journal = {INTERNATIONAL ECONOMIC REVIEW},
Year = {2009},
Volume = {50},
Number = {2},
Pages = {543-575},
Month = {MAY},
Abstract = {We extend to a fiscal federalism setting the literature on
   redistributive in-kind transfers in the presence of nonlinear income
   taxation. Local governments have a cost advantage, motivating
   decentralization of the in-kind transfer. The cost structure varies
   across regions, and the central government cannot observe which region
   is which. We show that decentralized in-kind transfers can, in this
   setting, be an even more important instrument for relaxing
   self-selection constraints, thus, helping redistribution, than in
   single-government models. We characterize the optimal marginal tax rates
   and matching grants. The grants have a very different structure than the
   one derived in earlier studies.},
