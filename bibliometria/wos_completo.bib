@article{ WOS:000405993200269,
Author = {Chen, Zhi and Zhao, Nan},
Title = {Research on the Effect of Fiscal Decentralization on Science and
   Technology Input in China},
Journal = {AGRO FOOD INDUSTRY HI-TECH},
Year = {2017},
Volume = {28},
Number = {3},
Pages = {3014-3019},
Month = {MAY-JUN},
Abstract = {In order to test fiscal decentralization effect in China, this paper
   constructs five spatial panel models with fiscal revenue
   decentralization, fiscal expenditure decentralization, fiscal revenue
   autonomy degree, fiscal expenditure autonomy degree, and fiscal
   decentralization combination. The results show that local fiscal
   decentralization can promote the local investment in science technology.
   With the decentralization deepening, the positive effect will increase,
   the autonomy of local government become stronger, and the competition
   between local governments can reduce the positive effect. but the
   competition between local governments can reduce it. At the beginning of
   economic development, local governments continue to increase investment
   in science and technology to ensure the region economy can grow fast.
   When the economic level has reached a certain degree, local governments
   will control the size of the fiscal expenditure on science and
   technology and increase investment in other aspects to ensure the
   healthy and sustainable economic growth.},
