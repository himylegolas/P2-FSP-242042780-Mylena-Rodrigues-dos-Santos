@article{ WOS:000326167300005,
Author = {Chu, Jian and Zheng, Xiao-Ping},
Title = {CHINA'S FISCAL DECENTRALIZATION AND REGIONAL ECONOMIC GROWTH},
Journal = {JAPANESE ECONOMIC REVIEW},
Year = {2013},
Volume = {64},
Number = {4},
Pages = {537-549},
Month = {DEC},
Abstract = {The present paper applies Lucas's theory of endogenous growth and
   Stiglitz's theory of local public goods to build an econometric model
   consisting of five simultaneous equations to study China's fiscal
   decentralization effects on regional economic growth. The model is
   estimated by two-stage least squares using a set of panel data on 31
   Chinese provinces during 1996-2005. The estimated results show that
   China's fiscal decentralization increased the local governments'
   expenditure on physical infrastructure and education, which led to the
   rising local physical capital stock and human capital levels,
   respectively, and then resulted in the growth of regional economies.},
