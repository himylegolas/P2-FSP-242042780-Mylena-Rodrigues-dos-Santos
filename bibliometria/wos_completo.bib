@article{ WOS:001723273000001,
Author = {Li, Xuewen and Ji, Liurulin and Li, Hongyang and Yao, Lianying},
Title = {Land as a discretionary extra-budgetary revenue tool: land reserve
   system, monopoly supply power and local government finance},
Journal = {JOURNAL OF ASIAN PUBLIC POLICY},
Year = {2026},
Month = {2026 MAR 21},
Abstract = {This article conceptualizes the Land Reserve System (LRS) as an
   institutional fiscal instrument through which Chinese local governments
   transform land into discretionary extra-budgetary revenue under post
   tax-sharing fiscal pressures. Leveraging a panel of 218 prefecture-level
   cities (1999-2013), we assess whether and how LRS adoption restructures
   local fiscal revenue composition. The empirical strategy combines a
   Difference-in-Differences framework with an identification approach that
   exploits the exogenous fiscal shock induced by the 2002 corporate income
   tax reform and an instrumental variable based on Cox hazard-predicted
   adoption timing. We find that adopting the LRS leads to a large and
   persistent increase in land-finance dependence, measured by the share of
   land transfer revenue in the general public budget revenue. Mechanism
   analyses suggest that the LRS enables more land for commercial and
   service uses, consistent with strategic supply management, thereby
   increasing housing prices and reinforcing land based fiscal extraction.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
